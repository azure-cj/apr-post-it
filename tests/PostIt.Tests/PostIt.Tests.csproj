<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console test runner (see Framework/TestFramework.cs). Run: dotnet run, project tests/PostIt.Tests -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PostIt.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CS1998</NoWarn>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PostIt.Core\PostIt.Core.csproj" />
    <ProjectReference Include="..\..\src\PostIt.Presentation\PostIt.Presentation.csproj" />
  </ItemGroup>

</Project>
