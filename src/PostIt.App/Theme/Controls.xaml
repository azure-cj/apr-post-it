<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:PostIt.App.Controls"
                    xmlns:cv="clr-namespace:PostIt.App.Converters">

    <!-- ===================================================================
         Styles and templates. Every key here is listed in docs/UI-KIT.md.
         =================================================================== -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ============================== Converters ============================== -->
    <cv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <cv:BoolToVisibilityConverter x:Key="BoolToVisInverted" Invert="True" />
    <cv:NullToVisibilityConverter x:Key="NullToCollapsed" />
    <cv:NullToVisibilityConverter x:Key="NullToVisible" Invert="True" />
    <cv:EmptyToVisibilityConverter x:Key="EmptyToCollapsed" />
    <cv:EmptyToVisibilityConverter x:Key="EmptyToVisible" Invert="True" />
    <cv:InvertBoolConverter x:Key="InvertBool" />
    <cv:EnumEqualsConverter x:Key="EnumEquals" />
    <cv:BadgeKindConverter x:Key="BadgeKind" />
    <cv:CheckGlyphConverter x:Key="CheckGlyph" />
    <cv:CheckBrushConverter x:Key="CheckBrush" />
    <cv:CheckBrushConverter x:Key="CheckBgBrush" Background="True" />
    <cv:ThumbnailConverter x:Key="Thumbnail" />

    <!-- ============================== Text ============================== -->
    <Style x:Key="Text.PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Cream}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Cream}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Text.ItemTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Cream}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Text.Subtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Cream}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="21" />
    </Style>
    <Style x:Key="Text.Muted" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Text.Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted2}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Gold uppercase section label, e.g. "PRE-POST CHECKS". Write the text in capitals. -->
    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Gold}" />
    </Style>
    <Style x:Key="Text.FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Cream}" />
        <Setter Property="Margin" Value="0,0,0,7" />
    </Style>
    <!-- Big number in a stat tile. -->
    <Style x:Key="Text.Stat" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Cream}" />
    </Style>
    <Style x:Key="Text.TableHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted2}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Text.Cell" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Cream}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Text.Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Text.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
    </Style>

    <!-- ============================== Surfaces ============================== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="20" />
    </Style>
    <Style x:Key="Card.Tight" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="14,12" />
    </Style>
    <!-- A row inside a card: queue items, search results. -->
    <Style x:Key="Item" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Panel2}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="Item.Selected" TargetType="Border" BasedOn="{StaticResource Item}">
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Gold}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style x:Key="Item.Pinned" TargetType="Border" BasedOn="{StaticResource Item}">
        <Setter Property="Background" Value="{StaticResource Brush.AmberBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Amber}" />
    </Style>
    <!-- Stat tile: Text.Stat number + Text.Muted caption. -->
    <Style x:Key="StatTile" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Panel2}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,12" />
    </Style>
    <!-- Public posting text box (green). -->
    <Style x:Key="PublicBox" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.GreenBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Green}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,14" />
    </Style>
    <!-- Collapsed internal section (dashed look approximated with a dim border). -->
    <Style x:Key="InternalBox" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Input}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Line2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,12" />
    </Style>
    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource Brush.Line}" />
        <Setter Property="Margin" Value="0,14" />
    </Style>
    <!-- Round avatar with initials: <Border Style="{StaticResource Avatar}"><TextBlock Style="{StaticResource Text.Avatar}" Text="{Binding Initials}"/></Border> -->
    <Style x:Key="Avatar" TargetType="Border">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="Background" Value="{StaticResource Brush.Panel2}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Line2}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="Text.Avatar" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Gold}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Numbered circle used in step lists. -->
    <Style x:Key="NumberCircle" TargetType="Border">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="Background" Value="{StaticResource Brush.Panel2}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Line2}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ============================== Buttons ============================== -->
    <Style x:Key="Btn.Base" TargetType="Button">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Cream}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Gold}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Gold}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Ink}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F0D06A" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Btn.Secondary" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Panel2}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Line2}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Cream}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Brush.GoldDim}" />
                <Setter Property="Background" Value="{StaticResource Brush.Hover}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Btn.Ghost" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush.Cream}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Line2}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Btn.Danger" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.RedBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.RedLine}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Red}" />
    </Style>
    <!-- Small variants (height 34). -->
    <Style x:Key="Btn.Primary.Sm" TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="13.5" />
    </Style>
    <Style x:Key="Btn.Secondary.Sm" TargetType="Button" BasedOn="{StaticResource Btn.Secondary}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="13.5" />
    </Style>
    <Style x:Key="Btn.Ghost.Sm" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="13.5" />
    </Style>
    <!-- Square icon-only button (put a Text.Glyph inside). Set ToolTip. -->
    <Style x:Key="Btn.Icon" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <!-- Text-only link-style button. -->
    <Style x:Key="Btn.Link" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Brush.Blue}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter x:Name="Cp" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Cp" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Cp" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented toggle option (like Front/Back in the ID Maker). Put RadioButtons with the same GroupName inside a Border Style="{StaticResource Segment}". -->
    <Style x:Key="Segment" TargetType="Border">
        <Setter Property="Background" Value="#0F0F0F" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="Segment.Option" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="16" Padding="16,6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Gold}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Ink}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Cream}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Pill-shaped toggle chip (quick picks such as Today / Tomorrow). Works on RadioButton or ToggleButton. -->
    <Style x:Key="Chip" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{StaticResource Brush.Panel2}" BorderBrush="{StaticResource Brush.Line}" BorderThickness="1" CornerRadius="16" Padding="12,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Cream}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Cream}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Ink}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.GoldDim}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Chip.Radio" TargetType="RadioButton" BasedOn="{StaticResource Chip}" />

    <!-- ============================== Text input ============================== -->
    <!-- Implicit TextBox style. Placeholder text: set Tag="Type a name…". For live updates bind with UpdateSourceTrigger=PropertyChanged. -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Brush.Input}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Cream}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Line2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Cream}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.Gold}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <Grid Margin="{TemplateBinding Padding}">
                            <TextBlock x:Name="Placeholder"
                                       Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{StaticResource Brush.Muted2}"
                                       Margin="3,0,0,0"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       TextWrapping="Wrap"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.GoldDim}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Gold}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Multi-line text (pasted lists). Set Height or MinHeight. -->
    <Style x:Key="TextBox.Multiline" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="MinHeight" Value="110" />
        <Setter Property="FontSize" Value="14.5" />
    </Style>

    <!-- Read-only, selectable text that looks like plain text (e.g. the public posting text). -->
    <Style x:Key="TextBox.ReadOnly" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Cream}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.Gold}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" HorizontalScrollBarVisibility="Disabled" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Search box with a magnifier glyph. Placeholder via Tag. -->
    <Style x:Key="TextBox.Search" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{StaticResource Icon.Search}" FontFamily="{StaticResource IconFont}" FontSize="15"
                                       Foreground="{StaticResource Brush.Muted2}" VerticalAlignment="Center" Margin="2,0,10,0" />
                            <TextBlock x:Name="Placeholder" Grid.Column="1"
                                       Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{StaticResource Brush.Muted2}" Margin="3,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Focusable="False" VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.GoldDim}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Gold}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Borderless text box used inside the editable ComboBox. -->
    <Style x:Key="TextBox.Bare" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Cream}" />
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Cream}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.Gold}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== ComboBox ============================== -->
    <!-- Implicit ComboBox style. Supports IsEditable="True" (type or pick). -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Brush.Cream}" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Line}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Gold}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Brush.Cream}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="{StaticResource Brush.Input}" BorderBrush="{StaticResource Brush.Line2}" BorderThickness="1" CornerRadius="10">
                                        <TextBlock Text="{StaticResource Icon.ChevronDown}" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                   Foreground="{StaticResource Brush.Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.GoldDim}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Gold}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Margin="14,0,36,0"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                        <TextBox x:Name="PART_EditableTextBox" Style="{StaticResource TextBox.Bare}"
                                 Margin="14,1,36,1" Visibility="Hidden" FontSize="{TemplateBinding FontSize}"
                                 IsReadOnly="{TemplateBinding IsReadOnly}" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               PopupAnimation="Fade" IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border x:Name="DropDown" Margin="0,4,0,0" Padding="4"
                                    MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{StaticResource Brush.Panel2}" BorderBrush="{StaticResource Brush.Line2}"
                                    BorderThickness="1" CornerRadius="10">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"
                                                TextElement.Foreground="{StaticResource Brush.Cream}" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="DropDown" Property="MinHeight" Value="40" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== CheckBox ============================== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Brush.Cream}" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="20" Height="20" CornerRadius="5" Background="{StaticResource Brush.Input}"
                                BorderBrush="{StaticResource Brush.Line2}" BorderThickness="1" VerticalAlignment="Center">
                            <TextBlock x:Name="Mark" Text="{StaticResource Icon.Check}" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="{StaticResource Brush.Ink}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Gold}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Gold}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Gold}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== ProgressBar ============================== -->
    <!-- Thin rounded bar. Gold by default; set Foreground="{StaticResource Brush.Green}" for a finished one. -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="8" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Gold}" />
        <Setter Property="Background" Value="{StaticResource Brush.Panel2}" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="4" Background="{TemplateBinding Background}" />
                        <Border x:Name="PART_Indicator" CornerRadius="4" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== ScrollBar ============================== -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" CornerRadius="4" Background="{StaticResource Brush.Line2}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.GoldDim}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" Margin="2" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" Margin="2" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================== ToolTip ============================== -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Brush.Cream}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource Brush.Panel2}" BorderBrush="{StaticResource Brush.Line2}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== Custom controls ============================== -->
    <!-- <ui:Badge Kind="ok|pending|cool|todo|neutral|cat|gold|info" ShowDot="True" Content="Posted"/> -->
    <Style TargetType="ui:Badge">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{StaticResource Brush.Panel2}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:Badge">
                    <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="10,3,10,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{TemplateBinding Foreground}" Margin="0,0,6,0" VerticalAlignment="Center"
                                     Visibility="{TemplateBinding ShowDot, Converter={StaticResource BoolToVis}}" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Kind" Value="ok">
                <Setter Property="Background" Value="{StaticResource Brush.GreenBg}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Green}" />
            </Trigger>
            <Trigger Property="Kind" Value="pending">
                <Setter Property="Background" Value="{StaticResource Brush.AmberBg}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Amber}" />
            </Trigger>
            <Trigger Property="Kind" Value="cool">
                <Setter Property="Background" Value="{StaticResource Brush.RedBg}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Red}" />
            </Trigger>
            <Trigger Property="Kind" Value="cat">
                <Setter Property="Background" Value="{StaticResource Brush.GoldSoft}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Gold}" />
            </Trigger>
            <Trigger Property="Kind" Value="gold">
                <Setter Property="Background" Value="{StaticResource Brush.Gold}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Ink}" />
            </Trigger>
            <Trigger Property="Kind" Value="info">
                <Setter Property="Background" Value="{StaticResource Brush.BlueBg}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Blue}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- <ui:Alert Kind="ok|warn|error|info"><TextBlock TextWrapping="Wrap" Text="…"/></ui:Alert> — icon is chosen by Kind. -->
    <Style TargetType="ui:Alert">
        <Setter Property="Background" Value="{StaticResource Brush.BlueBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BlueLine}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Blue}" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:Alert">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Icon" Grid.Column="0" Text="{StaticResource Icon.Info}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       Foreground="{TemplateBinding Foreground}" VerticalAlignment="Top" Margin="0,2,12,0" />
                            <ContentPresenter Grid.Column="1" TextElement.Foreground="{StaticResource Brush.Cream}" TextElement.FontSize="14" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Kind" Value="ok">
                            <Setter TargetName="Icon" Property="Text" Value="{StaticResource Icon.CheckCircle}" />
                        </Trigger>
                        <Trigger Property="Kind" Value="warn">
                            <Setter TargetName="Icon" Property="Text" Value="{StaticResource Icon.Warning}" />
                        </Trigger>
                        <Trigger Property="Kind" Value="error">
                            <Setter TargetName="Icon" Property="Text" Value="{StaticResource Icon.Error}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Kind" Value="ok">
                <Setter Property="Background" Value="{StaticResource Brush.GreenBg}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.GreenLine}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Green}" />
            </Trigger>
            <Trigger Property="Kind" Value="warn">
                <Setter Property="Background" Value="{StaticResource Brush.AmberBg}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.AmberLine}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Amber}" />
            </Trigger>
            <Trigger Property="Kind" Value="error">
                <Setter Property="Background" Value="{StaticResource Brush.RedBg}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.RedLine}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Red}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
