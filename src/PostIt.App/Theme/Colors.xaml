<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ===================================================================
         APG Post-It palette — matches the Alpha Premier ID Maker:
         near-black page, dark rounded cards, gold actions, cream text.
         =================================================================== -->

    <Color x:Key="Color.Bg">#0B0B0B</Color>
    <Color x:Key="Color.Panel">#171717</Color>
    <Color x:Key="Color.Panel2">#1F1F1F</Color>
    <Color x:Key="Color.Input">#101010</Color>
    <Color x:Key="Color.Line">#2A2A2A</Color>
    <Color x:Key="Color.Line2">#363636</Color>
    <Color x:Key="Color.Gold">#E8C652</Color>
    <Color x:Key="Color.GoldDim">#B89A3F</Color>
    <Color x:Key="Color.Cream">#F3ECD8</Color>
    <Color x:Key="Color.Muted">#B1A78F</Color>
    <Color x:Key="Color.Muted2">#7F7866</Color>
    <Color x:Key="Color.Ink">#141414</Color>

    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}" />
    <SolidColorBrush x:Key="Brush.Panel" Color="{StaticResource Color.Panel}" />
    <SolidColorBrush x:Key="Brush.Panel2" Color="{StaticResource Color.Panel2}" />
    <SolidColorBrush x:Key="Brush.Input" Color="{StaticResource Color.Input}" />
    <SolidColorBrush x:Key="Brush.Line" Color="{StaticResource Color.Line}" />
    <SolidColorBrush x:Key="Brush.Line2" Color="{StaticResource Color.Line2}" />
    <SolidColorBrush x:Key="Brush.Gold" Color="{StaticResource Color.Gold}" />
    <SolidColorBrush x:Key="Brush.GoldDim" Color="{StaticResource Color.GoldDim}" />
    <SolidColorBrush x:Key="Brush.GoldSoft" Color="#1C1A12" />
    <SolidColorBrush x:Key="Brush.Cream" Color="{StaticResource Color.Cream}" />
    <SolidColorBrush x:Key="Brush.Muted" Color="{StaticResource Color.Muted}" />
    <SolidColorBrush x:Key="Brush.Muted2" Color="{StaticResource Color.Muted2}" />
    <SolidColorBrush x:Key="Brush.Ink" Color="{StaticResource Color.Ink}" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#262626" />

    <SolidColorBrush x:Key="Brush.Green" Color="#34C477" />
    <SolidColorBrush x:Key="Brush.GreenBg" Color="#0F2318" />
    <SolidColorBrush x:Key="Brush.GreenLine" Color="#1D4A2F" />
    <SolidColorBrush x:Key="Brush.Amber" Color="#E3A93B" />
    <SolidColorBrush x:Key="Brush.AmberBg" Color="#2A200C" />
    <SolidColorBrush x:Key="Brush.AmberLine" Color="#4A3A16" />
    <SolidColorBrush x:Key="Brush.Red" Color="#E25F5F" />
    <SolidColorBrush x:Key="Brush.RedBg" Color="#2A1212" />
    <SolidColorBrush x:Key="Brush.RedLine" Color="#4A2020" />
    <SolidColorBrush x:Key="Brush.Blue" Color="#6FB3FF" />
    <SolidColorBrush x:Key="Brush.BlueBg" Color="#101C2A" />
    <SolidColorBrush x:Key="Brush.BlueLine" Color="#1F3550" />

    <!-- Fonts: Outfit is embedded (Fonts/*.ttf, OFL). Icons: Windows' built-in Segoe Fluent Icons (Win 11) / MDL2 Assets (Win 10). -->
    <FontFamily x:Key="AppFont">pack://application:,,,/Fonts/#Outfit</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <CornerRadius x:Key="Radius.Card">16</CornerRadius>
    <CornerRadius x:Key="Radius.Control">10</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <!-- Icon glyphs. Use: <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.Copy}"/> -->
    <sys:String x:Key="Icon.Search">&#xE721;</sys:String>
    <sys:String x:Key="Icon.Copy">&#xE8C8;</sys:String>
    <sys:String x:Key="Icon.Lock">&#xE72E;</sys:String>
    <sys:String x:Key="Icon.Download">&#xE896;</sys:String>
    <sys:String x:Key="Icon.Folder">&#xE8B7;</sys:String>
    <sys:String x:Key="Icon.FolderOpen">&#xE838;</sys:String>
    <sys:String x:Key="Icon.Link">&#xE71B;</sys:String>
    <sys:String x:Key="Icon.Save">&#xE74E;</sys:String>
    <sys:String x:Key="Icon.Add">&#xE710;</sys:String>
    <sys:String x:Key="Icon.Close">&#xE711;</sys:String>
    <sys:String x:Key="Icon.Check">&#xE73E;</sys:String>
    <sys:String x:Key="Icon.CheckCircle">&#xE930;</sys:String>
    <sys:String x:Key="Icon.Warning">&#xE7BA;</sys:String>
    <sys:String x:Key="Icon.Error">&#xEA39;</sys:String>
    <sys:String x:Key="Icon.Info">&#xE946;</sys:String>
    <sys:String x:Key="Icon.Clock">&#xE823;</sys:String>
    <sys:String x:Key="Icon.Calendar">&#xE787;</sys:String>
    <sys:String x:Key="Icon.Settings">&#xE713;</sys:String>
    <sys:String x:Key="Icon.People">&#xE716;</sys:String>
    <sys:String x:Key="Icon.AddPerson">&#xE8FA;</sys:String>
    <sys:String x:Key="Icon.List">&#xE8FD;</sys:String>
    <sys:String x:Key="Icon.Chart">&#xE9D2;</sys:String>
    <sys:String x:Key="Icon.CheckList">&#xE9D5;</sys:String>
    <sys:String x:Key="Icon.ChevronLeft">&#xE76B;</sys:String>
    <sys:String x:Key="Icon.ChevronRight">&#xE76C;</sys:String>
    <sys:String x:Key="Icon.ChevronUp">&#xE70E;</sys:String>
    <sys:String x:Key="Icon.ChevronDown">&#xE70D;</sys:String>
    <sys:String x:Key="Icon.ArrowUp">&#xE74A;</sys:String>
    <sys:String x:Key="Icon.ArrowDown">&#xE74B;</sys:String>
    <sys:String x:Key="Icon.Back">&#xE72B;</sys:String>
    <sys:String x:Key="Icon.Forward">&#xE72A;</sys:String>
    <sys:String x:Key="Icon.OpenExternal">&#xE8A7;</sys:String>
    <sys:String x:Key="Icon.Photo">&#xE91B;</sys:String>
    <sys:String x:Key="Icon.Paste">&#xE77F;</sys:String>
    <sys:String x:Key="Icon.SwitchUser">&#xE748;</sys:String>
    <sys:String x:Key="Icon.Refresh">&#xE72C;</sys:String>
    <sys:String x:Key="Icon.Pin">&#xE718;</sys:String>
    <sys:String x:Key="Icon.Edit">&#xE70F;</sys:String>
    <sys:String x:Key="Icon.Delete">&#xE74D;</sys:String>
    <sys:String x:Key="Icon.Share">&#xE72D;</sys:String>
    <sys:String x:Key="Icon.Shield">&#xEA18;</sys:String>
    <sys:String x:Key="Icon.Document">&#xE8A5;</sys:String>
    <sys:String x:Key="Icon.Tag">&#xE8EC;</sys:String>
    <sys:String x:Key="Icon.MapPin">&#xE707;</sys:String>
    <sys:String x:Key="Icon.Home">&#xE80F;</sys:String>

</ResourceDictionary>
