<UserControl x:Class="PostIt.App.Views.AssignView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PostIt.Presentation.ViewModels;assembly=PostIt.Presentation"
             xmlns:core="clr-namespace:PostIt.Core;assembly=PostIt.Core"
             xmlns:ui="clr-namespace:PostIt.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AssignViewModel}"
             d:DesignWidth="1080" d:DesignHeight="720">

    <!-- Three cards: find properties | the queue being built | paste a typed list. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================ FIND PROPERTIES ============================ -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource Text.Label}" Text="FIND PROPERTIES" />
                <TextBox Grid.Row="1" Style="{StaticResource TextBox.Search}" Margin="0,14,0,0" Tag="Search property folders"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="2" Style="{StaticResource Text.Hint}" Margin="0,8,0,12"
                           Text="Type part of the folder name. Properties still in cooldown can't be added." />

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Candidates}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AssignCandidateRowViewModel}">
                                <Border Style="{StaticResource Item}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Text.ItemTitle}" Text="{Binding Name}" TextWrapping="Wrap" TextTrimming="None" />
                                            <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding Meta}" Margin="0,3,0,0" />
                                            <ui:Badge Kind="{Binding BadgeKind}" ShowDot="{Binding BadgeShowsDot}" Content="{Binding BadgeText}" Margin="0,7,0,0"
                                                      Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Style="{StaticResource Text.Hint}" Text="{Binding CantAddText}" Margin="0,6,0,0"
                                                       Visibility="{Binding ShowCantAdd, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <Grid Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <Button Style="{StaticResource Btn.Primary.Sm}" Content="Add" Command="{Binding AddCommand}"
                                                    ToolTip="Add to the end of the queue"
                                                    Visibility="{Binding ShowAddButton, Converter={StaticResource BoolToVis}}" />
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                        Visibility="{Binding IsInDraft, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.Check}" FontSize="12"
                                                           Foreground="{StaticResource Brush.Green}" Margin="0,0,6,0" />
                                                <TextBlock Text="Added" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Green}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Grid.Row="3" Style="{StaticResource Text.Muted}" Text="{Binding SearchEmptyText}" Margin="0,8,0,0"
                           Visibility="{Binding HasNoCandidates, Converter={StaticResource BoolToVis}}" />

                <TextBlock Grid.Row="4" Style="{StaticResource Text.Hint}" Text="{Binding SearchFooter}" Margin="0,12,0,0" />
            </Grid>
        </Border>

        <!-- ============================ QUEUE FOR ============================ -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Label + Today / Tomorrow quick picks -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Text.Label}" Text="QUEUE FOR" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Chip.Radio}" GroupName="AssignDay" Content="Today" Margin="0,0,6,0"
                                     IsChecked="{Binding IsToday, Mode=OneWay}" Command="{Binding TodayCommand}" />
                        <RadioButton Style="{StaticResource Chip.Radio}" GroupName="AssignDay" Content="Tomorrow"
                                     IsChecked="{Binding IsTomorrow, Mode=OneWay}" Command="{Binding TomorrowCommand}" />
                    </StackPanel>
                </Grid>

                <!-- Intern -->
                <ComboBox Grid.Row="1" Margin="0,14,0,0" IsEditable="False"
                          ItemsSource="{Binding Interns}" SelectedItem="{Binding SelectedIntern}"
                          ToolTip="Whose queue you're building">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:AppUser}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource Avatar}" Width="26" Height="26" CornerRadius="13">
                                    <TextBlock Style="{StaticResource Text.Avatar}" Text="{Binding Initials}" FontSize="10.5" />
                                </Border>
                                <TextBlock Text="{Binding Name}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- ◀ date ▶ -->
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource Btn.Icon}" Height="44" Command="{Binding PreviousDayCommand}" ToolTip="Previous day">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.ChevronLeft}" FontSize="12" />
                    </Button>
                    <Border Grid.Column="1" Height="44" Margin="6,0" CornerRadius="10" BorderThickness="1"
                            Background="{StaticResource Brush.Input}" BorderBrush="{StaticResource Brush.Line2}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.Calendar}" FontSize="14"
                                       Foreground="{StaticResource Brush.Muted}" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding DateLabel}" FontSize="15" Foreground="{StaticResource Brush.Cream}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button Grid.Column="2" Style="{StaticResource Btn.Icon}" Height="44" Command="{Binding NextDayCommand}" ToolTip="Next day">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.ChevronRight}" FontSize="12" />
                    </Button>
                </Grid>

                <!-- Count + reorder hint -->
                <Grid Grid.Row="3" Margin="0,14,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Text.Muted}" Text="{Binding QueueCountText}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Hint}" Text="Use ▲▼ to reorder" Margin="8,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding HasQueueItems, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!-- The draft, in posting order -->
                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Draft}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:QueueDraftRowViewModel}">
                                <Border Style="{StaticResource Item}" Padding="12,10,8,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource NumberCircle}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Number}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Brush.Muted}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Text.ItemTitle}" Text="{Binding Name}" TextWrapping="Wrap" TextTrimming="None" />
                                            <WrapPanel Margin="0,6,0,0">
                                                <ui:Badge Kind="{Binding CategoryKind}" Content="{Binding CategoryText}" Margin="0,0,6,0" />
                                                <ui:Badge Kind="{Binding StatusKind}" ShowDot="True" Content="{Binding StatusText}"
                                                          Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" />
                                            </WrapPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <StackPanel VerticalAlignment="Center">
                                                <Button Style="{StaticResource Btn.Icon}" Width="28" Height="24" BorderThickness="0"
                                                        Command="{Binding MoveUpCommand}" ToolTip="Move up">
                                                    <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.ChevronUp}" FontSize="10" />
                                                </Button>
                                                <Button Style="{StaticResource Btn.Icon}" Width="28" Height="24" BorderThickness="0"
                                                        Command="{Binding MoveDownCommand}" ToolTip="Move down">
                                                    <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.ChevronDown}" FontSize="10" />
                                                </Button>
                                            </StackPanel>
                                            <Button Style="{StaticResource Btn.Icon}" Width="28" Height="28" BorderThickness="0" Margin="2,0,0,0"
                                                    Command="{Binding RemoveCommand}" ToolTip="{Binding RemoveToolTip}"
                                                    ToolTipService.ShowOnDisabled="True">
                                                <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.Close}" FontSize="11" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Row="4" Margin="12,24,12,0" VerticalAlignment="Top"
                            Visibility="{Binding IsQueueEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.List}" FontSize="22"
                               Foreground="{StaticResource Brush.Muted2}" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,10,0,0" TextAlignment="Center"
                               Text="No properties yet. Add them from the left, or paste a list." />
                </StackPanel>

                <!-- Save -->
                <StackPanel Grid.Row="5">
                    <Border Style="{StaticResource Divider}" Margin="0,8,0,14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource Btn.Primary}" Command="{Binding SaveCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.Save}" Margin="0,0,8,0" />
                                <TextBlock Text="Save queue" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource Btn.Ghost.Sm}" Content="Undo changes" Margin="8,0,0,0"
                                Command="{Binding UndoCommand}" ToolTip="Go back to the saved queue" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="6" Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource Text.Hint}" Text="{Binding SaveStateText}" Foreground="{StaticResource Brush.Amber}" Margin="0,0,0,2"
                               Visibility="{Binding SaveStateText, Converter={StaticResource EmptyToCollapsed}}" />
                    <TextBlock Style="{StaticResource Text.Hint}" Text="{Binding QueueHint}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ PASTE A LIST ============================ -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource Text.Label}" Text="PASTE A LIST" />
                <TextBlock Grid.Row="1" Style="{StaticResource Text.Hint}" Margin="0,8,0,12"
                           Text="The app matches each name to a property folder and flags typos." />
                <TextBox Grid.Row="2" Style="{StaticResource TextBox.Multiline}" Height="140" Tag="One property per line"
                         Text="{Binding PasteText, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Row="3" Style="{StaticResource Btn.Primary}" Margin="0,12,0,0" Command="{Binding MatchCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.Search}" Margin="0,0,8,0" />
                        <TextBlock Text="Match to property folders" />
                    </StackPanel>
                </Button>

                <!-- Matches header -->
                <StackPanel Grid.Row="4" Visibility="{Binding HasMatches, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource Divider}" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource Text.Label}" Text="MATCHES" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Hint}" Text="{Binding MatchSummary}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>

                <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Matches}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PasteMatchRowViewModel}">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12" VerticalAlignment="Top"
                                            Background="{Binding Mark, Converter={StaticResource CheckBgBrush}}">
                                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{Binding Mark, Converter={StaticResource CheckGlyph}}"
                                                   Foreground="{Binding Mark, Converter={StaticResource CheckBrush}}" FontSize="11"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,1,0,0">
                                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Text}" />
                                        <TextBlock Style="{StaticResource Text.Hint}" Text="{Binding SubText}" Margin="0,2,0,0"
                                                   Visibility="{Binding SubText, Converter={StaticResource EmptyToCollapsed}}" />
                                        <Grid Margin="0,6,0,0" Visibility="{Binding IsSuggestion, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource Text.Muted}" Text="{Binding SuggestionText}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Style="{StaticResource Btn.Ghost.Sm}" Content="Use it" Margin="8,0,0,0"
                                                    Command="{Binding UseItCommand}" ToolTip="Add the suggested property to the queue" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button Grid.Row="6" Style="{StaticResource Btn.Secondary}" Margin="0,10,0,0"
                        Command="{Binding AddAllMatchedCommand}"
                        Visibility="{Binding HasMatches, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.Add}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding AddAllLabel}" />
                    </StackPanel>
                </Button>

                <ui:Alert Grid.Row="7" Kind="ok" Margin="0,10,0,0"
                          Visibility="{Binding AddedMessage, Converter={StaticResource EmptyToCollapsed}}">
                    <TextBlock TextWrapping="Wrap" Text="{Binding AddedMessage}" />
                </ui:Alert>
            </Grid>
        </Border>
    </Grid>
</UserControl>
