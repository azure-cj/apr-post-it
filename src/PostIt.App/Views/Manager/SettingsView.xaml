<UserControl x:Class="PostIt.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PostIt.Presentation.ViewModels;assembly=PostIt.Presentation"
             xmlns:ui="clr-namespace:PostIt.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignWidth="1080" d:DesignHeight="720">

    <!-- A form: the cards scroll if the window is small; the Save bar stays put. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ======================= Left: data + rules ======================= -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">

                    <!-- DATA -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource Text.Label}" Text="DATA" VerticalAlignment="Center" />
                                <ui:Badge Grid.Column="1" Kind="info" ShowDot="True" Content="PROTOTYPE · sample data"
                                          Visibility="{Binding UsingSampleData, Converter={StaticResource BoolToVis}}" />
                            </Grid>

                            <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Properties folder" Margin="0,16,0,7" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Tag="C:\…\Properties"
                                         Text="{Binding PropertiesFolder, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Style="{StaticResource Btn.Secondary}" Content="Browse…" Margin="8,0,0,0"
                                        Command="{Binding BrowsePropertiesFolderCommand}" />
                            </Grid>
                            <TextBlock Style="{StaticResource Text.Hint}" Text="{Binding PropertiesFolderHint}" Margin="0,6,0,0" />
                            <TextBlock Style="{StaticResource Text.Hint}" Text="{Binding PropertiesFolderError}" Foreground="{StaticResource Brush.Red}" Margin="0,4,0,0"
                                       Visibility="{Binding PropertiesFolderError, Converter={StaticResource EmptyToCollapsed}}" />

                            <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Tracker folder" Margin="0,16,0,7" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Tag="C:\…\Tracker"
                                         Text="{Binding TrackerFolder, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Style="{StaticResource Btn.Secondary}" Content="Browse…" Margin="8,0,0,0"
                                        Command="{Binding BrowseTrackerFolderCommand}" />
                            </Grid>
                            <TextBlock Style="{StaticResource Text.Hint}" Text="{Binding TrackerFolderHint}" Margin="0,6,0,0" />
                            <TextBlock Style="{StaticResource Text.Hint}" Text="{Binding TrackerFolderError}" Foreground="{StaticResource Brush.Red}" Margin="0,4,0,0"
                                       Visibility="{Binding TrackerFolderError, Converter={StaticResource EmptyToCollapsed}}" />

                            <Border Style="{StaticResource Divider}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Text.Hint}" Text="Settings (and the sample data) are kept in:" />
                                    <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding DataFolder}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource Btn.Ghost.Sm}" Margin="12,0,0,0" VerticalAlignment="Center"
                                        Command="{Binding OpenDataFolderCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.FolderOpen}" FontSize="13" Margin="0,0,8,0" />
                                        <TextBlock Text="Open data folder" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- RULES -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Label}" Text="RULES" />
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Cooldown (days)" />
                                    <TextBox Width="110" HorizontalAlignment="Left" Tag="7"
                                             Text="{Binding CooldownDaysText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource Text.Hint}" Text="{Binding CooldownHint}" Margin="0,6,0,0" />
                                    <TextBlock Style="{StaticResource Text.Hint}" Text="{Binding CooldownDaysError}" Foreground="{StaticResource Brush.Red}" Margin="0,4,0,0"
                                               Visibility="{Binding CooldownDaysError, Converter={StaticResource EmptyToCollapsed}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Repost due after (days)" />
                                    <TextBox Width="110" HorizontalAlignment="Left" Tag="14"
                                             Text="{Binding RepostDueDaysText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource Text.Hint}" Text="{Binding RepostDueHint}" Margin="0,6,0,0" />
                                    <TextBlock Style="{StaticResource Text.Hint}" Text="{Binding RepostDueDaysError}" Foreground="{StaticResource Brush.Red}" Margin="0,4,0,0"
                                               Visibility="{Binding RepostDueDaysError, Converter={StaticResource EmptyToCollapsed}}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ======================= Right: team + danger zone ======================= -->
                <StackPanel Grid.Column="1">

                    <!-- TEAM & ACCOUNTS -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Label}" Text="TEAM &amp; ACCOUNTS" />

                            <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Facebook accounts" Margin="0,16,0,7" />
                            <TextBox Style="{StaticResource TextBox.Multiline}" Height="104" Tag="One account per line"
                                     Text="{Binding FbAccountsText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Text.Hint}" Text="{Binding FbAccountsHint}" Margin="0,6,0,0" />

                            <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Team" Margin="0,16,0,7" />
                            <TextBox Style="{StaticResource TextBox.Multiline}" Height="150" Tag="Maria Santos, Manager"
                                     Text="{Binding TeamText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Text.Hint}" Text="{Binding TeamHint}" Margin="0,6,0,0" />
                            <TextBlock Style="{StaticResource Text.Hint}" Text="{Binding TeamError}" Foreground="{StaticResource Brush.Red}" Margin="0,4,0,0"
                                       Visibility="{Binding TeamError, Converter={StaticResource EmptyToCollapsed}}" />
                        </StackPanel>
                    </Border>

                    <!-- DANGER ZONE -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" BorderBrush="{StaticResource Brush.RedLine}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Label}" Text="DANGER ZONE" Foreground="{StaticResource Brush.Red}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Text.Body}" Text="Reset sample data" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,2,0,0"
                                               Text="Recreates the PROTOTYPE sample folders and tracker, with dates moved to today. Your own folders aren't touched." />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource Btn.Danger}" Margin="16,0,0,0" VerticalAlignment="Center"
                                        Command="{Binding ResetSampleDataCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.Refresh}" Margin="0,0,8,0" />
                                        <TextBlock Text="Reset sample data" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ======================= Save bar ======================= -->
        <Border Grid.Row="1" Style="{StaticResource Card.Tight}" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource Text.Muted}" Text="{Binding SaveStateText}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Style="{StaticResource Btn.Ghost.Sm}" Content="Undo changes" Margin="12,0,10,0" VerticalAlignment="Center"
                        Command="{Binding UndoCommand}" />
                <Button Grid.Column="2" Style="{StaticResource Btn.Primary}" Command="{Binding SaveCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.Save}" Margin="0,0,8,0" />
                        <TextBlock Text="Save settings" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
