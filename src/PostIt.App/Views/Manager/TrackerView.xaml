<UserControl x:Class="PostIt.App.Views.TrackerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PostIt.Presentation.ViewModels;assembly=PostIt.Presentation"
             xmlns:ui="clr-namespace:PostIt.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TrackerViewModel}"
             d:DesignWidth="1080" d:DesignHeight="720">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================= Date stepper + refresh ======================= -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Style="{StaticResource Btn.Icon}" Command="{Binding PreviousDayCommand}" ToolTip="Previous day">
                    <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.ChevronLeft}" FontSize="12" />
                </Button>
                <Border Height="34" Margin="6,0" Padding="14,0" CornerRadius="10" BorderThickness="1"
                        Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.Line}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.Calendar}" FontSize="14"
                                   Foreground="{StaticResource Brush.Muted}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding DateLabel}" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.Cream}" />
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource Btn.Icon}" Command="{Binding NextDayCommand}" ToolTip="Next day">
                    <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.ChevronRight}" FontSize="12" />
                </Button>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource Btn.Link}" Content="Back to today" Margin="14,0,0,0"
                    Command="{Binding TodayCommand}"
                    Visibility="{Binding IsNotToday, Converter={StaticResource BoolToVis}}" />
            <Button Grid.Column="3" Style="{StaticResource Btn.Icon}" Command="{Binding RefreshCommand}" ToolTip="Refresh — read the tracker again">
                <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.Refresh}" FontSize="14" />
            </Button>
        </Grid>

        <!-- ======================= Stat tiles ======================= -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StatTile}" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Stat}" Text="{Binding PostedCount}" Foreground="{StaticResource Brush.Green}" />
                    <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding PostedLabel}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource StatTile}" Margin="0,0,16,0"
                    ToolTip="Posts waiting for the group admin's approval, from any day">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Stat}" Text="{Binding PendingCount}" Foreground="{StaticResource Brush.Amber}" />
                    <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding PendingLabel}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource StatTile}" Margin="0,0,16,0"
                    ToolTip="Interns who finished their queue for this day, out of those with a queue">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Stat}">
                        <Run Text="{Binding InternsDoneText, Mode=OneWay}" /><Run Text="{Binding InternsOfText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Brush.Muted}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding InternsDoneLabel}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource StatTile}" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Stat}" Text="{Binding DueCount}" Foreground="{StaticResource Brush.Gold}" />
                    <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding DueLabel}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               ToolTip="{Binding DueLabel}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource StatTile}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Stat}" Text="{Binding NeverCount}" Foreground="{StaticResource Brush.Red}" />
                    <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding NeverLabel}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================= Posts table + right column ======================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Today's posts -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource Text.Title}" Text="{Binding PostsTitle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Muted}" Text="{Binding PostsSubtitle}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>

                    <!-- Table header (same column widths as the rows below) -->
                    <Border Grid.Row="1" Margin="0,16,0,0" Padding="0,0,0,10" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush.Line}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Text.TableHeader}" Text="TIME" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.TableHeader}" Text="PROPERTY" />
                            <TextBlock Grid.Column="2" Style="{StaticResource Text.TableHeader}" Text="INTERN" />
                            <TextBlock Grid.Column="3" Style="{StaticResource Text.TableHeader}" Text="FB ACCOUNT" />
                            <TextBlock Grid.Column="4" Style="{StaticResource Text.TableHeader}" Text="STATUS" />
                            <TextBlock Grid.Column="5" Style="{StaticResource Text.TableHeader}" Text="LINK" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Posts}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TrackerPostRowViewModel}">
                                    <Border Padding="0,11" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush.Line}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="52" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource Text.Cell}" Text="{Binding Time}" Foreground="{StaticResource Brush.Muted}" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Cell}" Text="{Binding Property}" ToolTip="{Binding Property}" Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource Text.Cell}" Text="{Binding Intern}" ToolTip="{Binding InternFullName}" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="3" Style="{StaticResource Text.Cell}" Text="{Binding Account}" ToolTip="{Binding Account}" Margin="0,0,10,0" />
                                            <ui:Badge Grid.Column="4" Kind="{Binding StatusKind}" ShowDot="True" Content="{Binding StatusText}" />
                                            <Button Grid.Column="5" Style="{StaticResource Btn.Link}" Content="Open" HorizontalAlignment="Left"
                                                    Command="{Binding OpenLinkCommand}" ToolTip="{Binding Link}"
                                                    Visibility="{Binding HasLink, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Grid.Column="5" Style="{StaticResource Text.Cell}" Text="—" Foreground="{StaticResource Brush.Muted2}"
                                                       Visibility="{Binding HasNoLink, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,28,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                                Visibility="{Binding HasNoPosts, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.Calendar}" FontSize="22"
                                   Foreground="{StaticResource Brush.Muted2}" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource Text.Muted}" Text="No posts logged on this day yet." Margin="0,10,0,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource Text.Hint}" Text="{Binding PostsFooter}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource Btn.Ghost.Sm}" Margin="12,0,0,0"
                                Command="{Binding OpenTrackerFolderCommand}"
                                ToolTip="Posts.csv and Assignments.csv — the two tabs of the tracker sheet">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.FolderOpen}" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Open tracker folder" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right column -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Who's done -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Label}" Text="WHO'S DONE" Margin="0,0,0,14" />
                        <TextBlock Style="{StaticResource Text.Muted}" Text="No interns on the team yet. Add them in Settings."
                                   Visibility="{Binding HasNoInterns, Converter={StaticResource BoolToVis}}" />
                        <ScrollViewer MaxHeight="236" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Interns}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:InternProgressRowViewModel}">
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource Avatar}" VerticalAlignment="Top" Margin="0,2,12,0">
                                                <TextBlock Style="{StaticResource Text.Avatar}" Text="{Binding Initials}" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Style="{StaticResource Text.ItemTitle}" Text="{Binding Name}" FontSize="15"
                                                               VerticalAlignment="Center" ToolTip="{Binding Name}" />
                                                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Muted}" Text="{Binding ProgressText}"
                                                               TextWrapping="NoWrap" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                    <ui:Badge Grid.Column="2" Kind="ok" Content="Done" Margin="8,0,0,0"
                                                              Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                                <Grid Margin="0,7,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ProgressBar Grid.Column="0" Value="{Binding ProgressValue, Mode=OneWay}" VerticalAlignment="Center">
                                                        <ProgressBar.Style>
                                                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Green}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ProgressBar.Style>
                                                    </ProgressBar>
                                                    <Button Grid.Column="1" Style="{StaticResource Btn.Link}" Content="{Binding QueueLinkText}" Margin="12,0,0,0"
                                                            Command="{Binding QueueCommand}" ToolTip="Open this intern's queue on the Assign screen" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Needs attention -->
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Text.Label}" Text="NEEDS ATTENTION" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Hint}" Text="{Binding AttentionCountText}" VerticalAlignment="Center"
                                       Visibility="{Binding HasAttention, Converter={StaticResource BoolToVis}}" />
                            <Button Grid.Column="2" Style="{StaticResource Btn.Link}" Content="Assign" Margin="10,0,0,0"
                                    Command="{Binding AssignCommand}" ToolTip="Plan the next day's queues" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Attention}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AttentionRowViewModel}">
                                        <Border Padding="0,8" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush.Line}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Style="{StaticResource Text.ItemTitle}" Text="{Binding Name}" FontSize="15" ToolTip="{Binding Name}" />
                                                    <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding Detail}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <ui:Badge Grid.Column="1" Kind="{Binding BadgeKind}" Content="{Binding BadgeText}" Margin="8,0,0,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Grid.Row="1" Style="{StaticResource Text.Muted}" Margin="0,6,0,0"
                                   Text="All caught up — every property was posted recently."
                                   Visibility="{Binding HasNoAttention, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
