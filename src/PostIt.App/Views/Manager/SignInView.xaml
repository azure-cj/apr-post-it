<UserControl x:Class="PostIt.App.Views.SignInView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PostIt.Presentation.ViewModels;assembly=PostIt.Presentation"
             xmlns:ui="clr-namespace:PostIt.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SignInViewModel}"
             d:DesignWidth="1270" d:DesignHeight="720">

    <!-- No sidebar on this page: a centred card. The ScrollViewer only matters for a very large team. -->
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid MinHeight="{Binding ViewportHeight, ElementName=Scroller}">
            <Border Style="{StaticResource Card}" Padding="32,28" MaxWidth="800" Margin="0,8"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.PageTitle}" Text="{Binding Heading}" />
                    <TextBlock Style="{StaticResource Text.Subtitle}" Text="{Binding Subtitle}" Margin="0,8,0,0" />

                    <!-- Signing in with a key. Hidden on sample data, where names are picked instead. -->
                    <StackPanel Margin="0,24,0,0" Visibility="{Binding UsingKey, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Web app link" />
                        <TextBox Text="{Binding ScriptUrl, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding NotBusy}" Margin="0,4,0,0" />

                        <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Your key" Margin="0,14,0,0" />
                        <TextBox x:Name="KeyBox"
                                 Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding NotBusy}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Text.Hint}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Your manager gives you this. It is also your identity — don't share it." />

                        <Button Style="{StaticResource Btn.Primary}" Content="Sign in" Margin="0,18,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding ConnectCommand}" IsDefault="True" />

                        <ui:Alert Kind="warn" Margin="0,16,0,0"
                                  Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Status, Mode=OneWay}" TextWrapping="Wrap" />
                        </ui:Alert>
                    </StackPanel>

                    <!-- Nobody on the team -->
                    <StackPanel Margin="0,24,0,0" Visibility="{Binding HasNoUsers, Converter={StaticResource BoolToVis}}">
                        <ui:Alert Kind="warn">
                            <TextBlock TextWrapping="Wrap"
                                       Text="Nobody is on the team yet. Reset the sample data to bring back the demo team." />
                        </ui:Alert>
                        <Button Style="{StaticResource Btn.Primary}" Command="{Binding ResetSampleDataCommand}"
                                HorizontalAlignment="Left" Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.Refresh}" Margin="0,0,8,0" />
                                <TextBlock Text="Reset sample data" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Managers -->
                    <StackPanel Margin="0,26,0,0" Visibility="{Binding HasManagers, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Text.Label}" Text="MANAGERS" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Managers}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:UserTileViewModel}">
                                    <Button Style="{StaticResource Btn.Secondary}" Width="232" Height="Auto" Padding="14,12" Margin="0,0,12,12"
                                            HorizontalContentAlignment="Stretch"
                                            Command="{Binding SignInCommand}" ToolTip="{Binding Name}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource Avatar}" Width="38" Height="38" CornerRadius="19" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Text.Avatar}" Text="{Binding Initials}" FontSize="13" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Text.ItemTitle}" Text="{Binding Name}" FontSize="15" />
                                                <ui:Badge Kind="{Binding BadgeKind}" Content="{Binding RoleLabel}" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Interns -->
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding HasInterns, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Text.Label}" Text="INTERNS" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Interns}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:UserTileViewModel}">
                                    <Button Style="{StaticResource Btn.Secondary}" Width="232" Height="Auto" Padding="14,12" Margin="0,0,12,12"
                                            HorizontalContentAlignment="Stretch"
                                            Command="{Binding SignInCommand}" ToolTip="{Binding Name}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource Avatar}" Width="38" Height="38" CornerRadius="19" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Text.Avatar}" Text="{Binding Initials}" FontSize="13" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Text.ItemTitle}" Text="{Binding Name}" FontSize="15" />
                                                <ui:Badge Kind="{Binding BadgeKind}" Content="{Binding RoleLabel}" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Where the data lives -->
                    <Border Style="{StaticResource Divider}" Margin="0,12,0,14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Text.Hint}" Text="{Binding PropertiesFolderText}" />
                            <TextBlock Style="{StaticResource Text.Hint}" Text="{Binding TrackerFolderText}" Margin="0,3,0,0" />
                        </StackPanel>
                        <ui:Badge Grid.Column="1" Kind="info" ShowDot="True" Content="PROTOTYPE · sample data"
                                  Margin="16,0,0,0" VerticalAlignment="Top"
                                  Visibility="{Binding UsingSampleData, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
