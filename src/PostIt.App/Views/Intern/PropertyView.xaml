<UserControl x:Class="PostIt.App.Views.PropertyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PostIt.Presentation.ViewModels;assembly=PostIt.Presentation"
             xmlns:ui="clr-namespace:PostIt.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PropertyViewModel}"
             d:DesignWidth="1080" d:DesignHeight="720">

    <!-- Step 2 · Copy (mockup 02-property): text, internal section and photos on the left; checks, history and next step on the right. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!-- ============================ Load error ============================ -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource Card}" VerticalAlignment="Top"
                Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <ui:Alert Kind="error">
                    <TextBlock TextWrapping="Wrap" Text="{Binding LoadError}" />
                </ui:Alert>
                <Button Style="{StaticResource Btn.Secondary}" Command="{Binding BackCommand}" HorizontalAlignment="Left" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.Back}" Margin="0,0,8,0" />
                        <TextBlock Text="Back" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ============================ Posting text + photos ============================ -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0"
                Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Steps + Back -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:StepChips Grid.Column="0" ActiveStep="{Binding ActiveStep}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource Btn.Ghost.Sm}" Command="{Binding BackCommand}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.Back}" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="Back" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Title -->
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Title}" FontSize="22" Text="{Binding PropertyName}" />
                        <TextBlock Style="{StaticResource Text.Subtitle}" Text="{Binding Subtitle}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource Btn.Ghost.Sm}" Command="{Binding OpenFolderCommand}" VerticalAlignment="Center"
                            Margin="12,0,0,0" ToolTip="Open the property folder in Explorer">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.FolderOpen}" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Open folder" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Alerts -->
                <StackPanel Grid.Row="2">
                    <ui:Alert Kind="warn" Margin="0,0,0,10" Visibility="{Binding HasDocWarning, Converter={StaticResource BoolToVis}}">
                        <TextBlock TextWrapping="Wrap" Text="{Binding DocWarning}" />
                    </ui:Alert>
                    <ui:Alert Kind="error" Margin="0,0,0,10" Visibility="{Binding IsInCooldown, Converter={StaticResource BoolToVis}}">
                        <TextBlock TextWrapping="Wrap" Text="{Binding CooldownMessage}" />
                    </ui:Alert>
                    <ui:Alert Kind="error" Margin="0,0,0,10" Visibility="{Binding IsCopyBlocked, Converter={StaticResource BoolToVis}}">
                        <TextBlock TextWrapping="Wrap" Text="{Binding CopyBlockedMessage}" />
                    </ui:Alert>
                </StackPanel>

                <!-- Public posting text: the only part that is ever copied -->
                <Border Grid.Row="3" Style="{StaticResource PublicBox}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.Green}" Text="PUBLIC POSTING TEXT"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource Btn.Primary.Sm}" Command="{Binding CopyCommand}"
                                    ToolTip="Copies the public text only">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.Copy}" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="Copy" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBox Grid.Row="1" Style="{StaticResource TextBox.ReadOnly}" Text="{Binding PublicText, Mode=OneWay}"
                                 VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>

                <!-- Internal section: hidden by default, never copied -->
                <Border Grid.Row="4" Style="{StaticResource InternalBox}" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid Visibility="{Binding HasInternalSection, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.Lock}"
                                       Foreground="{StaticResource Brush.Muted}" Margin="0,0,12,0" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"
                                       Text="Internal section (commission, terms) — hidden, never copied" />
                            <Button Grid.Column="2" Style="{StaticResource Btn.Ghost.Sm}" Content="{Binding InternalToggleLabel}"
                                    Command="{Binding ToggleInternalCommand}" Margin="12,0,0,0" MinWidth="64" />
                        </Grid>
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsInternalShown, Converter={StaticResource BoolToVis}}">
                            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding InternalText}" />
                            </ScrollViewer>
                            <TextBlock Style="{StaticResource Text.Hint}" Text="For reference only. It is never copied." Margin="0,8,0,0" />
                        </StackPanel>
                        <Grid Visibility="{Binding HasNoInternalSection, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.Info}"
                                       Foreground="{StaticResource Brush.Muted2}" Margin="0,0,12,0" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Hint}" VerticalAlignment="Center"
                                       Text="No internal section in this doc — read the whole text before you post." />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Photos header -->
                <Grid Grid.Row="5" Margin="0,16,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Text.Label}" Text="PHOTOS" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Hint}" Text="{Binding PhotoCountText}" Margin="12,0,0,0"
                               VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasPhotos, Converter={StaticResource BoolToVis}}" />
                    <Button Grid.Column="2" Style="{StaticResource Btn.Link}" Command="{Binding DownloadAllCommand}"
                            ToolTip="Saves every photo to Downloads\APG Post-It and opens the folder"
                            Visibility="{Binding HasPhotos, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.Download}" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Download all" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Photos -->
                <Grid Grid.Row="6">
                    <TextBlock Style="{StaticResource Text.Hint}" Text="No photos in this folder."
                               Visibility="{Binding NoPhotos, Converter={StaticResource BoolToVis}}" />
                    <ScrollViewer MaxHeight="232" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasPhotos, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Photos}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PropertyPhotoRow}">
                                    <Grid Height="108" Margin="0,0,8,8" ToolTip="{Binding FileName}">
                                        <Border CornerRadius="10" Background="{StaticResource Brush.Panel2}" BorderBrush="{StaticResource Brush.Line}"
                                                BorderThickness="1">
                                            <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.Photo}" FontSize="22"
                                                       Foreground="{StaticResource Brush.Muted2}" HorizontalAlignment="Center" />
                                        </Border>
                                        <Rectangle RadiusX="10" RadiusY="10">
                                            <Rectangle.Fill>
                                                <ImageBrush ImageSource="{Binding Path, Converter={StaticResource Thumbnail}, ConverterParameter=360}"
                                                            Stretch="UniformToFill" />
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <Button Style="{StaticResource Btn.Ghost.Sm}" Command="{Binding OpenCommand}" Height="28" Padding="10,0"
                                                Background="{StaticResource Brush.Panel}" Foreground="{StaticResource Brush.Cream}"
                                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" ToolTip="Open this photo">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.OpenExternal}" FontSize="11" Margin="0,0,6,0" />
                                                <TextBlock Text="Open" FontSize="12.5" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- ============================ Checks, history, next ============================ -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Label}" Text="PRE-POST CHECKS" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Checks}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PropertyCheckRow}">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13" VerticalAlignment="Top"
                                                Background="{Binding Status, Converter={StaticResource CheckBgBrush}}">
                                            <TextBlock Style="{StaticResource Text.Glyph}" FontSize="11" HorizontalAlignment="Center"
                                                       Text="{Binding Status, Converter={StaticResource CheckGlyph}}"
                                                       Foreground="{Binding Status, Converter={StaticResource CheckBrush}}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Margin="12,3,0,0" FontSize="14.5" TextWrapping="Wrap" Foreground="{StaticResource Brush.Cream}"><Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" · " Foreground="{StaticResource Brush.Muted2}" /><Run Text="{Binding Detail, Mode=OneWay}" Foreground="{StaticResource Brush.Muted}" /></TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource Divider}" />

                        <TextBlock Style="{StaticResource Text.Label}" Text="POSTING HISTORY" Margin="0,0,0,10" />
                        <TextBlock Style="{StaticResource Text.Muted}" Text="Never posted." Visibility="{Binding NeverPosted, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
                            <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush.Line}" Padding="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="84" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource Text.TableHeader}" Text="DATE" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Text.TableHeader}" Text="FB ACCOUNT" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource Text.TableHeader}" Text="BY" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource Text.TableHeader}" Text="STATUS" />
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding History}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PropertyHistoryRow}">
                                        <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush.Line}" Padding="0,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="84" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Style="{StaticResource Text.Cell}" Text="{Binding Date}" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Cell}" Text="{Binding FbAccount}" Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="2" Style="{StaticResource Text.Cell}" Text="{Binding By}" />
                                                <ui:Badge Grid.Column="3" Kind="{Binding BadgeKind}" Content="{Binding StatusLabel}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Border Style="{StaticResource Divider}" />

                        <TextBlock Style="{StaticResource Text.Label}" Text="WHAT TO DO NEXT" Margin="0,0,0,12" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource NumberCircle}" Margin="0,0,12,0" VerticalAlignment="Top">
                                <TextBlock Text="1" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Gold}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" Text="Copy the public text above." Margin="0,2,0,0" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource NumberCircle}" Margin="0,0,12,0" VerticalAlignment="Top">
                                <TextBlock Text="2" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Gold}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" Text="Rephrase it in your AI tool so the post reads fresh." Margin="0,2,0,0" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource NumberCircle}" Margin="0,0,12,0" VerticalAlignment="Top">
                                <TextBlock Text="3" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Gold}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" Text="Post on Facebook with the photos, then log the link." Margin="0,2,0,0" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1">
                    <Border Style="{StaticResource Divider}" Margin="0,14,0,16" />
                    <Button Style="{StaticResource Btn.Primary}" Command="{Binding NextCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Next: log this post" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.Forward}" FontSize="13" Margin="10,0,0,0" />
                        </StackPanel>
                    </Button>
                    <TextBlock Style="{StaticResource Text.Hint}" Text="Still needed: FB account name, post link." Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
