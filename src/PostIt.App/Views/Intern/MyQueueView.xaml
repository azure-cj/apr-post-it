<UserControl x:Class="PostIt.App.Views.MyQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PostIt.Presentation.ViewModels;assembly=PostIt.Presentation"
             xmlns:ui="clr-namespace:PostIt.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MyQueueViewModel}"
             d:DesignWidth="1080" d:DesignHeight="720">

    <!-- Intern home (mockup 05-queue): the day's queue on the left, how it works + today's logs on the right. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <!-- ============================ Queue ============================ -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header: title, refresh, Today | Tomorrow -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Text.Title}" Text="{Binding Header}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource Btn.Icon}" Command="{Binding RefreshCommand}" ToolTip="Refresh the queue"
                            Margin="12,0,10,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.Refresh}" FontSize="14" />
                    </Button>
                    <Border Grid.Column="2" Style="{StaticResource Segment}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment.Option}" GroupName="MyQueueDay" Content="Today"
                                         IsChecked="{Binding Day, Converter={StaticResource EnumEquals}, ConverterParameter=Today}" />
                            <RadioButton Style="{StaticResource Segment.Option}" GroupName="MyQueueDay" Content="Tomorrow"
                                         IsChecked="{Binding Day, Converter={StaticResource EnumEquals}, ConverterParameter=Tomorrow}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Stat tiles -->
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource StatTile}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Stat}" Foreground="{StaticResource Brush.Gold}" Text="{Binding ToPostCount}" />
                            <TextBlock Style="{StaticResource Text.Muted}" Text="To post" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource StatTile}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Stat}" Foreground="{StaticResource Brush.Green}" Text="{Binding PostedCount}" />
                            <TextBlock Style="{StaticResource Text.Muted}" Text="Posted" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Stat}" Foreground="{StaticResource Brush.Amber}" Text="{Binding PendingCount}" />
                            <TextBlock Style="{StaticResource Text.Muted}" Text="Pending" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Progress -->
                <Grid Grid.Row="2" Margin="0,0,0,14" Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Grid.Column="0" Value="{Binding ProgressValue, Mode=OneWay}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Muted}" Text="{Binding ProgressText}" Margin="14,0,0,0"
                               VerticalAlignment="Center" TextWrapping="NoWrap" />
                </Grid>

                <!-- All done / preview notes -->
                <StackPanel Grid.Row="3">
                    <ui:Alert Kind="ok" Margin="0,0,0,12" Visibility="{Binding AllDone, Converter={StaticResource BoolToVis}}">
                        <TextBlock TextWrapping="Wrap" Text="All done for today — every property in your queue is posted." />
                    </ui:Alert>
                    <ui:Alert Kind="info" Margin="0,0,0,12" Visibility="{Binding ShowPreviewHint, Converter={StaticResource BoolToVis}}">
                        <TextBlock TextWrapping="Wrap" Text="Preview — you can start these tomorrow." />
                    </ui:Alert>
                </StackPanel>

                <!-- The list (scrolls inside the card) -->
                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                    <StackPanel>

                        <!-- Pending: pinned on top until the live link is added -->
                        <ItemsControl ItemsSource="{Binding PendingItems}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MyQueueItemRow}">
                                    <Border Style="{StaticResource Item.Pinned}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource NumberCircle}" Background="Transparent"
                                                    BorderBrush="{StaticResource Brush.Amber}" Margin="0,0,14,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.Pin}" FontSize="12"
                                                           Foreground="{StaticResource Brush.Amber}" HorizontalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Text.ItemTitle}" Text="{Binding Name}" />
                                                <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding Meta}" Margin="0,2,0,0"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <ui:Badge Grid.Column="2" Kind="pending" ShowDot="True" Content="Pending" Margin="12,0,12,0" />
                                            <Button Grid.Column="3" Style="{StaticResource Btn.Primary.Sm}" Command="{Binding AddLinkCommand}"
                                                    VerticalAlignment="Center" ToolTip="Paste the live link once the admin approves the post">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.Link}" FontSize="13" Margin="0,0,8,0" />
                                                    <TextBlock Text="Add link" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- To post, in the manager's order -->
                        <ItemsControl ItemsSource="{Binding ToPostItems}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MyQueueItemRow}">
                                    <Border Style="{StaticResource Item}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource NumberCircle}" Margin="0,0,14,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Number}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Cream}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Text.ItemTitle}" Text="{Binding Name}" />
                                                <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding Meta}" Margin="0,2,0,0"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <ui:Badge Kind="cool" ShowDot="True" Content="{Binding CooldownText}" Margin="0,0,8,0"
                                                          Visibility="{Binding IsInCooldown, Converter={StaticResource BoolToVis}}" />
                                                <ui:Badge Kind="cat" Content="{Binding Category}"
                                                          Visibility="{Binding HasCategory, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Style="{StaticResource Text.Muted}" Text="To post" TextWrapping="NoWrap"
                                                       VerticalAlignment="Center" Margin="14,0,14,0" />
                                            <Grid Grid.Column="4" VerticalAlignment="Center">
                                                <Button Style="{StaticResource Btn.Primary.Sm}" Content="Open" Command="{Binding OpenCommand}" MinWidth="76"
                                                        Visibility="{Binding ShowPrimaryOpen, Converter={StaticResource BoolToVis}}" />
                                                <Button Style="{StaticResource Btn.Secondary.Sm}" Content="Open" Command="{Binding OpenCommand}" MinWidth="76"
                                                        Visibility="{Binding ShowSecondaryOpen, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Posted -->
                        <ItemsControl ItemsSource="{Binding PostedItems}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MyQueueItemRow}">
                                    <Border Style="{StaticResource Item}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource NumberCircle}" Background="{StaticResource Brush.GreenBg}"
                                                    BorderBrush="{StaticResource Brush.GreenLine}" Margin="0,0,14,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.Check}" FontSize="11"
                                                           Foreground="{StaticResource Brush.Green}" HorizontalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Text.ItemTitle}" Text="{Binding Name}" />
                                                <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding Meta}" Margin="0,2,0,0"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource Btn.Link}" Command="{Binding ViewPostCommand}"
                                                    Margin="12,0,14,0" ToolTip="{Binding Link}"
                                                    Visibility="{Binding HasLink, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="View post" VerticalAlignment="Center" />
                                                    <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.OpenExternal}" FontSize="11" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <ui:Badge Grid.Column="3" Kind="ok" ShowDot="True" Content="Posted" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Empty queue -->
                <StackPanel Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Margin="0,0,0,40"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.CheckList}" FontSize="36"
                               Foreground="{StaticResource Brush.Muted2}" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Text.Title}" Text="{Binding EmptyTitle}" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" Margin="0,16,0,6" />
                    <TextBlock Style="{StaticResource Text.Muted}" Text="The manager adds properties on the Assign screen." TextAlignment="Center" />
                    <Button Style="{StaticResource Btn.Secondary}" Command="{Binding SearchCommand}" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.Search}" Margin="0,0,8,0" />
                            <TextBlock Text="Search properties" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ How it works + today's logs ============================ -->
        <Border Grid.Column="1" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Label}" Text="HOW IT WORKS" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource NumberCircle}" VerticalAlignment="Top" Margin="0,0,12,0">
                            <TextBlock Text="1" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="Open" />
                            <TextBlock Style="{StaticResource Text.Hint}" Text="The property folder and its posting text" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource NumberCircle}" VerticalAlignment="Top" Margin="0,0,12,0">
                            <TextBlock Text="2" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="Copy text" />
                            <TextBlock Style="{StaticResource Text.Hint}" Text="Public section only — the internal notes stay hidden" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource NumberCircle}" VerticalAlignment="Top" Margin="0,0,12,0">
                            <TextBlock Text="3" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="Rephrase in your AI tool" />
                            <TextBlock Style="{StaticResource Text.Hint}" Text="Keep the price and the contact numbers" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource NumberCircle}" VerticalAlignment="Top" Margin="0,0,12,0">
                            <TextBlock Text="4" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="Post on Facebook with the photos" />
                            <TextBlock Style="{StaticResource Text.Hint}" Text="Download them from the property page" />
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource NumberCircle}" VerticalAlignment="Top" Margin="0,0,12,0">
                            <TextBlock Text="5" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="Paste the link and Save" />
                            <TextBlock Style="{StaticResource Text.Hint}" Text="Closes the item and writes the tracker row" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />
                    <TextBlock Style="{StaticResource Text.Muted}" Text="Nothing to search for — the manager fills this list." />
                    <Border Style="{StaticResource Divider}" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.Label}" Text="YOUR LOGS TODAY" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Hint}" Text="{Binding TodayLabel}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Style="{StaticResource Text.Hint}" Text="Nothing logged yet today."
                               Visibility="{Binding NoMyLogs, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding MyLogs}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MyLogTodayRow}">
                                <Border Style="{StaticResource Item}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Text.ItemTitle}" FontSize="14.5" Text="{Binding Title}" />
                                            <TextBlock Style="{StaticResource Text.Hint}" Text="{Binding Meta}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <ui:Badge Grid.Column="1" Kind="{Binding BadgeKind}" Content="{Binding StatusLabel}" Margin="10,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
