<Window x:Class="PostIt.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:p="clr-namespace:PostIt.Presentation;assembly=PostIt.Presentation"
        xmlns:ui="clr-namespace:PostIt.App.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=p:ShellViewModel}"
        Title="APG Post-It"
        Width="1320" Height="840" MinWidth="1180" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Bg}"
        Foreground="{StaticResource Brush.Cream}"
        FontFamily="{StaticResource AppFont}"
        FontSize="14.5"
        Icon="Assets/postit.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Sidebar item: gold when its NavItem.IsActive. -->
        <Style x:Key="Btn.Nav" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Cream}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.GoldDim}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Gold}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Gold}" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.Ink}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Toast colours by kind. -->
        <Style x:Key="Toast" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Panel2}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Line2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,10,8,10" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Toast.KindName}" Value="Success">
                    <Setter Property="Background" Value="{StaticResource Brush.GreenBg}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Green}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Toast.KindName}" Value="Warning">
                    <Setter Property="Background" Value="{StaticResource Brush.AmberBg}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Amber}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Toast.KindName}" Value="Error">
                    <Setter Property="Background" Value="{StaticResource Brush.RedBg}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Red}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================ Top bar ============================ -->
        <Grid Grid.Row="0" Margin="22,0,22,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="#1A1A1A"
                    BorderBrush="{StaticResource Brush.Line}" BorderThickness="1" VerticalAlignment="Center">
                <Image Source="Assets/logo.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            <TextBlock Grid.Column="1" Text="APG Post-It" FontSize="22" FontWeight="Bold" Margin="14,0,0,2" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding Tagline}" Foreground="{StaticResource Brush.Muted}" FontSize="14.5"
                       Margin="16,2,16,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}" />

            <ui:Badge Grid.Column="3" Kind="info" ShowDot="True" Content="PROTOTYPE · sample data" Margin="0,0,14,0"
                      ToolTip="Running on the bundled sample folders and tracker. Point Settings at real folders to stop using it."
                      Visibility="{Binding UsingSampleData, Converter={StaticResource BoolToVis}}" />
            <TextBlock Grid.Column="4" Text="{Binding TodayLabel}" Foreground="{StaticResource Brush.Muted2}" FontSize="13.5"
                       VerticalAlignment="Center" Margin="0,0,16,0" />

            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource Avatar}">
                    <TextBlock Style="{StaticResource Text.Avatar}" Text="{Binding UserInitials}" />
                </Border>
                <TextBlock Text="{Binding UserLabel}" Foreground="{StaticResource Brush.Muted}" FontSize="14" Margin="10,0,10,0" VerticalAlignment="Center" />
                <Button Style="{StaticResource Btn.Icon}" Command="{Binding SignOutCommand}" ToolTip="Switch user">
                    <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.SwitchUser}" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============================ Body ============================ -->
        <Grid Grid.Row="1" Margin="22,4,22,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <DockPanel Grid.Column="0" Width="186" Margin="0,0,18,0" LastChildFill="True"
                       Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}">
                <TextBlock DockPanel.Dock="Bottom" Text="APG Post-It 0.1 · prototype" Style="{StaticResource Text.Mono}"
                           FontSize="11.5" Foreground="{StaticResource Brush.Muted2}" Margin="4,0,0,0" />
                <ItemsControl ItemsSource="{Binding NavItems}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type p:NavItem}">
                            <Button Style="{StaticResource Btn.Nav}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Key}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource Text.Glyph}" Text="{Binding Glyph}" FontSize="16" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" CornerRadius="10" Background="#33000000" Padding="8,1,8,2" VerticalAlignment="Center"
                                            Visibility="{Binding HasCount, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding Count}" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <!-- Current page (view chosen by Views/ViewTemplates.xaml) -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False" />

            <!-- Toast -->
            <Border Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource Toast}"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" MaxWidth="640"
                    Visibility="{Binding Toast, Converter={StaticResource NullToCollapsed}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Toast.Text}" TextWrapping="Wrap" MaxWidth="560" VerticalAlignment="Center" FontSize="14.5" />
                    <Button Style="{StaticResource Btn.Icon}" Width="28" Height="28" Margin="10,0,0,0" BorderThickness="0"
                            Command="{Binding DismissToastCommand}" ToolTip="Dismiss">
                        <TextBlock Style="{StaticResource Text.Glyph}" Text="{StaticResource Icon.Close}" FontSize="11" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
