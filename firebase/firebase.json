{
  "functions": [
    {
      "source": "functions",
      "codebase": "post-it",
      "ignore": ["node_modules", ".git", "src", "tsconfig.json", "*.local", "firebase-debug.log", "firebase-debug.*.log"],
      "predeploy": ["npm --prefix functions run build"]
    }
  ],
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
