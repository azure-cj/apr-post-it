+++ b/firebase/tests/posting.test.ts
@@ -0,0 +1,249 @@
+import { getFirestore } from "firebase-admin/firestore";
+import { beforeAll, beforeEach, describe, expect, it } from "vitest";
+import { manilaDay, weekOf, addDays } from "../functions/src/posting/rules.ts";
+import { admin, client, makeAccount, refusal, resetEmulator } from "./emulator.ts";
+
+// Post-It's functions (POST-IT-PLAN.md sections 7 and 8). Each refuses a signed-out caller, an account with no role, the
+// scanner, and the roles that mustn't use it (FIREBASE-PLAN.md 7.7); then Post-It's own rules: the cooldown, the FB
+// account, the held listing, and an agent seeing only their own.
+
+const LINK = "https://www.facebook.com/groups/apg/posts/1/";
+const TODAY = manilaDay(new Date());
+const WEEK = weekOf(TODAY);
+
+const FUNCTIONS = {
+  postingStart: { people: true, data: {} },
+  listPosts: { people: true, data: {} },
+  listAssignments: { people: true, data: {} },
+  logPost: { people: true, data: { folderId: "F1", title: "Casa", fbAccount: "Cyrus", link: LINK, status: "Posted" } },
+  addLink: { people: true, data: { postId: "x", link: LINK } },
+  setStatus: { people: true, data: { assignmentId: "x", status: "Posted" } },
+  saveQueues: { people: false, data: { week: WEEK, queues: [] } },
+  setRules: { people: false, data: { cooldownDays: 7 } },
+  setFbProfiles: { people: false, data: { uid: "x", fbProfiles: [] } },
+};
+
+const uids: Record<string, string> = {};
+
+async function freshTeam(): Promise<void> {
+  await resetEmulator();
+  for (const role of ["owner", "admin", "agent", "scanner"] as const) uids[role] = await makeAccount(role, role);
+  uids["nobody"] = await makeAccount("nobody", null);
+  uids["cj"] = await makeAccount("cj", "agent");
+  uids["ana"] = await makeAccount("ana", "agent");
+  await getFirestore(admin()).collection("users").doc(uids["cj"]).update({ fbProfiles: [{ account: "Cyrus", link: "" }, { account: "Kevs", link: "" }] });
+}
+
+async function as(who: string) {
+  const app = client();
+  await app.signIn(who);
+  return app;
+}
+
+/** A refused call's code, words and details. */
+async function failure(call: Promise<unknown>): Promise<{ code: string; message: string; details: Record<string, unknown> }> {
+  return call.then(
+    () => {
+      throw new Error("The call wasn't refused.");
+    },
+    (e: unknown) => e as { code: string; message: string; details: Record<string, unknown> },
+  );
+}
+
+const post = (folderId: string, more: Record<string, unknown> = {}) => ({ folderId, title: `Listing ${folderId}`, fbAccount: "Cyrus", link: LINK, status: "Posted", ...more });
+
+describe("who may call Post-It's functions", () => {
+  beforeAll(freshTeam);
+
+  describe.each(Object.entries(FUNCTIONS))("%s", (name, { people, data }) => {
+    it("refuses a signed-out caller", async () => {
+      expect(await refusal(client().call(name, data))).toMatchObject({ code: "functions/unauthenticated" });
+    });
+
+    it.each(people ? ["nobody", "scanner"] : ["nobody", "scanner", "agent"])("refuses %s", async (who) => {
+      expect(await refusal((await as(who)).call(name, data))).toMatchObject({ code: "functions/permission-denied" });
+    });
+  });
+});
+
+describe("logging a post", () => {
+  beforeEach(freshTeam);
+
+  it("logs it as the caller, on Manila's day, and tells the app what it wrote", async () => {
+    const reply = await (await as("cj")).call<Record<string, unknown>>("logPost", post("F1", { fbAccount: "Kevs" }));
+    expect(reply).toMatchObject({ status: "Posted", date: TODAY, by: uids["cj"], byName: "cj" });
+    expect(reply["time"]).toMatch(/^\d{2}:\d{2}$/);
+    const saved = await getFirestore(admin()).collection("posts").doc(String(reply["id"])).get();
+    expect(saved.data()).toMatchObject({ folderId: "F1", fbAccount: "Kevs", link: LINK, by: uids["cj"], sheetCopied: false });
+  });
+
+  it("refuses a second post of the same listing inside the cooldown, by anyone", async () => {
+    await (await as("cj")).call("logPost", post("F1"));
+    const e = await failure((await as("ana")).call("logPost", post("F1")));
+    expect(e).toMatchObject({ code: "functions/failed-precondition", details: { error: "cooldown", lastPosted: TODAY, nextAllowed: addDays(TODAY, 7) } });
+    expect(e.message).toMatch(/^Posted today \(.+\)\. The cooldown is 7 days — it can be posted again on /);
+  });
+
+  it("lets only one of two posts of the same listing at the same moment through", async () => {
+    const [cj, ana] = [await as("cj"), await as("ana")];
+    const results = await Promise.allSettled([cj.call("logPost", post("F1")), ana.call("logPost", post("F1"))]);
+    expect(results.filter((r) => r.status === "fulfilled")).toHaveLength(1);
+    expect((await getFirestore(admin()).collection("posts").where("folderId", "==", "F1").get()).size).toBe(1);
+  });
+
+  it("allows it again once the cooldown has passed", async () => {
+    await getFirestore(admin()).collection("cooldowns").doc("F1").set({ last: addDays(TODAY, -7) });
+    await expect((await as("ana")).call("logPost", post("F1"))).resolves.toMatchObject({ status: "Posted" });
+  });
+
+  it("refuses an FB account that isn't the poster's", async () => {
+    expect(await refusal((await as("cj")).call("logPost", post("F1", { fbAccount: "Someone Else" })))).toEqual({
+      code: "functions/permission-denied",
+      message: "You are not assigned to Someone Else. [403]",
+    });
+  });
+
+  it.each([
+    [{ link: "" }, "link-required"],
+    [{ link: "https://instagram.com/p/1" }, "bad-link"],
+    [{ status: "Done" }, "bad-status"],
+  ])("refuses %j", async (change, error) => {
+    const e = await (await as("cj")).call("logPost", post("F1", change)).catch((e: unknown) => e);
+    expect(e).toMatchObject({ code: "functions/invalid-argument", details: { error } });
+  });
+
+  it("lets an admin log for an agent, from that agent's account, but not an agent for someone else", async () => {
+    await expect((await as("admin")).call("logPost", post("F1", { postedBy: uids["cj"] }))).resolves.toMatchObject({ by: uids["cj"], byName: "cj" });
+    expect(await refusal((await as("ana")).call("logPost", post("F2", { postedBy: uids["cj"] })))).toMatchObject({ code: "functions/permission-denied" });
+  });
+
+  it("refuses a turned-off agent at once", async () => {
+    const app = await as("cj");
+    await (await as("owner")).call("setActive", { uid: uids["cj"], active: false });
+    expect(await refusal(app.call("logPost", post("F1")))).toMatchObject({ code: "functions/unauthenticated" });
+  });
+
+  it("gives an agent only their own posts, and an admin everyone's", async () => {
+    await (await as("cj")).call("logPost", post("F1"));
+    await (await as("ana")).call("logPost", post("F2", { fbAccount: "Ana FB" }));
+    expect((await (await as("ana")).call<{ posts: { folderId: string }[] }>("listPosts")).posts.map((p) => p.folderId)).toEqual(["F2"]);
+    expect((await (await as("admin")).call<{ posts: unknown[] }>("listPosts")).posts).toHaveLength(2);
+  });
+
+  it("makes a Pending post Posted with its link, the poster's own only", async () => {
+    const { id } = await (await as("cj")).call<{ id: string }>("logPost", post("F1", { status: "Pending" }));
+    const live = "https://www.facebook.com/groups/apg/posts/2/";
+    expect(await refusal((await as("ana")).call("addLink", { postId: id, link: live }))).toMatchObject({ code: "functions/not-found" });
+    await (await as("cj")).call("addLink", { postId: id, link: live });
+    expect((await getFirestore(admin()).collection("posts").doc(id).get()).data()).toMatchObject({ status: "Posted", link: live });
+  });
+});
+
+describe("weekly queues", () => {
+  beforeEach(freshTeam);
+
+  const queue = (who: string, ...folders: string[]) => ({ assignedTo: uids[who], items: folders.map((f) => ({ folderId: f, name: `Listing ${f}` })) });
+
+  it("saves several agents' queues for a week, and an agent sees only their own", async () => {
+    const reply = await (await as("admin")).call("saveQueues", { week: WEEK, queues: [queue("cj", "F1", "F2"), queue("ana", "F3")] });
+    expect(reply).toEqual({ saved: 3 });
