@@ -0,0 +1,15 @@
+/** One FB account a person posts as in Post-It, and its profile link ('' when none). One person may run several. */
+export interface FbProfile {
+  account: string;
+  link: string;
+}
+
+/** The FB accounts in a `users` document, as saved. */
+export function profilesOf(value: unknown): FbProfile[] {
+  if (!Array.isArray(value)) return [];
+  return value.flatMap((v: unknown) => {
+    const p = typeof v === "object" && v !== null ? (v as Record<string, unknown>) : {};
+    const account = typeof p["account"] === "string" ? p["account"].trim() : "";
+    return account ? [{ account, link: typeof p["link"] === "string" ? p["link"] : "" }] : [];
+  });
+}
diff --git a/firebase/functions/src/posting/rules.ts b/firebase/functions/src/posting/rules.ts
new file mode 100644
index 0000000..6188989
--- /dev/null
+++ b/firebase/functions/src/posting/rules.ts
@@ -0,0 +1,140 @@
+// Post-It's rules, without Firebase: Manila's days, the work week, Facebook's links and the posting rules' limits. The
+// same rules as Post-It's Apps Script (its server/Code.gs) and its app (src/core/week.ts, links.ts, cooldown.ts), so a
+// listing is refused here exactly when the app says it will be.
+
+const DAY_MS = 86_400_000;
+/** Manila is UTC+8 all year: no daylight saving. */
+const MANILA_MS = 8 * 60 * 60 * 1000;
+
+/** Manila's date at `when`, yyyy-MM-dd. */
+export function manilaDay(when: Date): string {
+  return new Date(when.getTime() + MANILA_MS).toISOString().slice(0, 10);
+}
+
+/** Manila's clock at `when`, HH:mm. */
+export function manilaTime(when: Date): string {
+  return new Date(when.getTime() + MANILA_MS).toISOString().slice(11, 16);
+}
+
+/** True for a real calendar day written yyyy-MM-dd. */
+export function isDay(text: unknown): text is string {
+  if (typeof text !== "string" || !/^\d{4}-\d{2}-\d{2}$/.test(text)) return false;
+  return new Date(`${text}T00:00:00Z`).toISOString().slice(0, 10) === text;
+}
+
+function dayNumber(day: string): number {
+  return Date.parse(`${day}T00:00:00Z`) / DAY_MS;
+}
+
+function isoDay(n: number): string {
+  return new Date(n * DAY_MS).toISOString().slice(0, 10);
+}
+
+/** Whole days from `from` to `to`, both yyyy-MM-dd. */
+export function daysBetween(from: string, to: string): number {
+  return dayNumber(to) - dayNumber(from);
+}
+
+export function addDays(day: string, n: number): string {
+  return isoDay(dayNumber(day) + n);
+}
+
+/**
+ * The week a day belongs to, named by its Monday: Monday to Friday give that Monday, Saturday and Sunday the next one,
+ * since Friday is the deadline. '' for anything that isn't a day.
+ */
+export function weekOf(day: string): string {
+  if (!isDay(day)) return "";
+  const n = dayNumber(day);
+  const weekday = new Date(n * DAY_MS).getUTCDay(); // 0 Sun … 6 Sat
+  if (weekday === 0) return isoDay(n + 1);
+  if (weekday === 6) return isoDay(n + 2);
+  return isoDay(n - (weekday - 1));
+}
+
+export function isMonday(day: unknown): day is string {
+  return isDay(day) && weekOf(day) === day;
+}
+
+/** True once `today` is past the week's Friday: its open items are Missed, and hold nothing. */
+export function isWeekOver(week: string, today: string): boolean {
+  return dayNumber(today) > dayNumber(week) + 4;
+}
+
+const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
+const WEEKDAYS = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
+
+/** "2–6 Nov", or "30 Oct – 3 Nov" across months. */
+export function weekLabel(week: string): string {
+  const mon = new Date(dayNumber(week) * DAY_MS);
+  const fri = new Date((dayNumber(week) + 4) * DAY_MS);
+  if (mon.getUTCMonth() === fri.getUTCMonth()) return `${mon.getUTCDate()}–${fri.getUTCDate()} ${MONTHS[fri.getUTCMonth()]}`;
+  return `${mon.getUTCDate()} ${MONTHS[mon.getUTCMonth()]} – ${fri.getUTCDate()} ${MONTHS[fri.getUTCMonth()]}`;
+}
+
+const plural = (n: number) => (n === 1 ? "1 day" : `${n} days`);
+
+/**
+ * The refusal's words when a listing last posted on `last` is inside the cooldown on `today`, or null when it may be
+ * posted. A post dated after today, from a skewed clock, counts as today's.
+ */
+export function cooldownWords(last: string, today: string, cooldownDays: number): { nextAllowed: string; message: string } | null {
+  const ago = Math.max(0, daysBetween(last, today));
+  if (ago >= cooldownDays) return null;
+  const next = addDays(last, cooldownDays);
+  const lastDate = new Date(`${last}T00:00:00Z`);
+  const nextDate = new Date(`${next}T00:00:00Z`);
+  const when = ago === 0 ? "today" : `${plural(ago)} ago`;
+  return {
+    nextAllowed: next,
+    message:
+      `Posted ${when} (${lastDate.getUTCDate()} ${MONTHS[lastDate.getUTCMonth()]}). The cooldown is ${plural(cooldownDays)} — ` +
+      `it can be posted again on ${WEEKDAYS[nextDate.getUTCDay()]} ${nextDate.getUTCDate()} ${MONTHS[nextDate.getUTCMonth()]} ${nextDate.getUTCFullYear()}.`,
+  };
+}
+
+const POST_HOSTS = ["facebook.com", "www.facebook.com", "m.facebook.com", "web.facebook.com", "fb.com", "fb.me"];
+const PROFILE_HOSTS = ["facebook.com", "www.facebook.com", "m.facebook.com", "web.facebook.com", "fb.com"];
+const LINK = /^https:\/\/([^/?#\s]+)(?:[/?#][^\s]*)?$/i;
+
+/** A Facebook post's link: https on one of Facebook's own hosts. */
+export function isPostLink(text: string): boolean {
+  const m = LINK.exec(text);
+  return m !== null && POST_HOSTS.includes(m[1]!.toLowerCase());
+}
+
+/** A profile link as saved: https:// put in front when it had no scheme. Null when it isn't Facebook's; '' stays ''. */
+export function profileLink(text: string): string | null {
+  let link = text.trim();
+  if (!link) return "";
+  if (!/^[a-z][a-z0-9+.-]*:\/\//i.test(link)) link = `https://${link}`;
+  const m = LINK.exec(link);
+  return m !== null && PROFILE_HOSTS.includes(m[1]!.toLowerCase()) ? link : null;
+}
+
+/** The posting rules an admin sets, with Post-It's defaults and limits. */
+export const RULE_LIMITS = {
+  cooldownDays: { fallback: 7, min: 1, max: 60, label: "The cooldown" },
+  repostDueDays: { fallback: 14, min: 1, max: 120, label: "The repost age" },
+  perWeek: { fallback: 40, min: 1, max: 200, label: "Listings per week" },
+} as const;
+
+export type RuleName = keyof typeof RULE_LIMITS;
+export type Rules = Record<RuleName, number>;
+
+/** The saved rules, each its default when missing or out of range. */
+export function readRules(saved: Record<string, unknown> | undefined): Rules {
+  const out = {} as Rules;
+  for (const name of Object.keys(RULE_LIMITS) as RuleName[]) {
+    const spec = RULE_LIMITS[name];
+    const n = saved?.[name];
+    out[name] = typeof n === "number" && Number.isInteger(n) && n >= spec.min && n <= spec.max ? n : spec.fallback;
+  }
+  return out;
+}
+
+export const NOT_SHARED = "Not Shared";
+export const QUEUE_STATUSES = [NOT_SHARED, "Pending", "Posted"] as const;
+export type QueueStatus = (typeof QUEUE_STATUSES)[number];
+export const POST_STATUSES = ["Posted", "Pending"] as const;
+export type PostStatus = (typeof POST_STATUSES)[number];
diff --git a/firebase/tests/posting.test.ts b/firebase/tests/posting.test.ts
