diff --git a/firebase/functions/src/posting/functions.ts b/firebase/functions/src/posting/functions.ts
new file mode 100644
index 0000000..d667aa5
--- /dev/null
+++ b/firebase/functions/src/posting/functions.ts
@@ -0,0 +1,449 @@
+import "../setup.js";
+import { FieldValue, getFirestore, type DocumentReference, type Query, type Transaction } from "firebase-admin/firestore";
+import { HttpsError, onCall, type CallableRequest } from "firebase-functions/https";
+import { requireCurrentRole } from "../people.js";
+import { profilesOf, type FbProfile } from "./profiles.js";
+import { isRole, MANAGERS, mayManage, PEOPLE, requireRole, type Role } from "../roles.js";
+import {
+  cooldownWords,
+  isMonday,
+  isPostLink,
+  isWeekOver,
+  manilaDay,
+  manilaTime,
+  NOT_SHARED,
+  POST_STATUSES,
+  profileLink,
+  QUEUE_STATUSES,
+  readRules,
+  RULE_LIMITS,
+  weekLabel,
+  weekOf,
+  type QueueStatus,
+  type RuleName,
+  type Rules,
+} from "./rules.js";
+
+// Post-It's functions (POST-IT-PLAN.md sections 7 and 8): the posts agents log, the weekly queues admins build, and the
+// posting rules. Each starts with requireRole; the ones that write check the caller's account now (requireCurrentRole),
+// so a turned-off agent can't log a post within the hour a sign-in lasts. An agent sees and changes only their own.
+//
+// The cooldown and the held rule are checked in a transaction with the write, so two people saving the same listing at
+// the same moment can't both get through. That replaces Post-It's Apps Script lock.
+
+const db = () => getFirestore();
+const posts = () => db().collection("posts");
+const assignments = () => db().collection("assignments");
+/** One document per listing, by folder ID: the day it was last posted. The cooldown reads one document, not a query. */
+const cooldowns = () => db().collection("cooldowns");
+const rulesDoc = () => db().doc("config/posting");
+
+function fields(request: CallableRequest): Record<string, unknown> {
+  const data: unknown = request.data;
+  return typeof data === "object" && data !== null ? (data as Record<string, unknown>) : {};
+}
+
+function textIn(data: Record<string, unknown>, key: string, words: string): string {
+  const value = typeof data[key] === "string" ? data[key].trim() : "";
+  if (!value) throw new HttpsError("invalid-argument", words);
+  return value;
+}
+
+/** A refusal the app tells apart by `error`, as Post-It's Apps Script replies did. */
+function refuse(code: "invalid-argument" | "failed-precondition" | "permission-denied" | "not-found", error: string, message: string, more: Record<string, unknown> = {}): HttpsError {
+  return new HttpsError(code, message, { error, ...more });
+}
+
+interface Person {
+  uid: string;
+  name: string;
+  role: Role | null;
+  active: boolean;
+  fbProfiles: FbProfile[];
+}
+
+async function personOf(uid: string, tx?: Transaction): Promise<Person | null> {
+  const ref = db().collection("users").doc(uid);
+  const doc = tx ? await tx.get(ref) : await ref.get();
+  if (!doc.exists) return null;
+  const role: unknown = doc.get("role");
+  return {
+    uid,
+    name: String(doc.get("name") ?? ""),
+    role: isRole(role) ? role : null,
+    active: doc.get("active") !== false,
+    fbProfiles: profilesOf(doc.get("fbProfiles")),
+  };
+}
+
+async function rulesNow(tx?: Transaction): Promise<Rules> {
+  const doc = tx ? await tx.get(rulesDoc()) : await rulesDoc().get();
+  return readRules(doc.data());
+}
+
+function audit(tx: Transaction, request: CallableRequest, what: string, change: Record<string, unknown>, before: Record<string, unknown> | null = null): void {
+  tx.set(db().collection("audit").doc(), { who: request.auth!.uid, what, before, after: change, at: FieldValue.serverTimestamp() });
+}
+
+// ---- Reading ---------------------------------------------------------------------------------------
+
+/** What Post-It needs at start: the rules, Manila's today and its week, and the caller with their FB accounts. */
+export const postingStart = onCall(async (request) => {
+  const role = requireRole(request, PEOPLE);
+  const me = await personOf(request.auth!.uid);
+  const today = manilaDay(new Date());
+  return {
+    rules: await rulesNow(),
+    today,
+    week: weekOf(today),
+    me: { uid: request.auth!.uid, name: me?.name ?? "", role, fbProfiles: me?.fbProfiles ?? [] },
+  };
+});
+
+/** A post as the app gets it. */
+function postOut(doc: FirebaseFirestore.DocumentSnapshot) {
+  return {
+    id: doc.id,
+    folderId: String(doc.get("folderId") ?? ""),
+    title: String(doc.get("title") ?? ""),
+    type: String(doc.get("type") ?? ""),
+    fbAccount: String(doc.get("fbAccount") ?? ""),
+    link: String(doc.get("link") ?? ""),
+    status: String(doc.get("status") ?? ""),
+    by: String(doc.get("by") ?? ""),
+    byName: String(doc.get("byName") ?? ""),
+    loggedBy: (doc.get("loggedBy") as string | undefined) ?? null,
+    date: String(doc.get("date") ?? ""),
+    time: String(doc.get("time") ?? ""),
+  };
+}
+
+/** The posts logged, oldest first: `from` a day on, when sent. An agent gets only their own. */
+export const listPosts = onCall(async (request) => {
+  const role = requireRole(request, PEOPLE);
+  const data = fields(request);
+  let query: Query = posts();
+  if (role === "agent") query = query.where("by", "==", request.auth!.uid);
+  if (data["from"] !== undefined) {
+    if (typeof data["from"] !== "string" || !/^\d{4}-\d{2}-\d{2}$/.test(data["from"])) throw new HttpsError("invalid-argument", "From must be a day written yyyy-MM-dd.");
+    query = query.where("date", ">=", data["from"]);
+  }
+  const docs = (await query.get()).docs.map(postOut);
+  docs.sort((a, b) => a.date.localeCompare(b.date) || a.time.localeCompare(b.time));
+  return { posts: docs };
+});
+
+function assignmentOut(doc: FirebaseFirestore.DocumentSnapshot) {
+  return {
+    id: doc.id,
+    week: String(doc.get("week") ?? ""),
+    assignedTo: String(doc.get("assignedTo") ?? ""),
+    assignedToName: String(doc.get("assignedToName") ?? ""),
+    folderId: String(doc.get("folderId") ?? ""),
+    name: String(doc.get("name") ?? ""),
+    order: Number(doc.get("order") ?? 0),
+    status: String(doc.get("status") ?? ""),
+  };
+}
+
+/** The queue items, by week then order: one `week` when sent. An agent gets only their own. */
+export const listAssignments = onCall(async (request) => {
+  const role = requireRole(request, PEOPLE);
+  const data = fields(request);
+  let query: Query = assignments();
+  if (role === "agent") query = query.where("assignedTo", "==", request.auth!.uid);
+  if (data["week"] !== undefined) {
+    if (!isMonday(data["week"])) throw refuse("invalid-argument", "bad-week", "The week must be a Monday written yyyy-MM-dd.");
+    query = query.where("week", "==", data["week"]);
+  }
+  const docs = (await query.get()).docs.map(assignmentOut);
+  docs.sort((a, b) => a.week.localeCompare(b.week) || a.assignedToName.localeCompare(b.assignedToName) || a.order - b.order);
+  return { assignments: docs };
+});
+
+// ---- Logging a post --------------------------------------------------------------------------------
+
+/** The person's queue item for the listing that isn't Posted yet, newest week first: the one a post moves on. */
+async function openItem(tx: Transaction, assignedTo: string, folderId: string): Promise<DocumentReference | null> {
+  const found = await tx.get(assignments().where("assignedTo", "==", assignedTo).where("folderId", "==", folderId));
+  const open = found.docs.filter((d) => d.get("status") !== "Posted").sort((a, b) => String(b.get("week")).localeCompare(String(a.get("week"))));
+  return open[0]?.ref ?? null;
+}
+
+/**
+ * A post logged: its link, Posted or Pending (waiting for the group's admin). Refused inside the cooldown, and from an FB
+ * account that isn't the poster's. An admin or owner may log for someone else with `postedBy`, a uid.
+ */
+export const logPost = onCall(async (request) => {
+  const role = await requireCurrentRole(request, PEOPLE);
+  const data = fields(request);
+  const folderId = textIn(data, "folderId", "Pick a listing.");
+  const title = textIn(data, "title", "Pick a listing.");
+  const fbAccount = textIn(data, "fbAccount", "Type the FB account you posted from.");
+  const link = typeof data["link"] === "string" ? data["link"].trim() : "";
+  if (!link) throw refuse("invalid-argument", "link-required", "Paste the post's link.");
+  if (!isPostLink(link)) throw refuse("invalid-argument", "bad-link", "That isn't a Facebook link.");
+  const status = data["status"];
+  if (!(POST_STATUSES as readonly unknown[]).includes(status)) throw refuse("invalid-argument", "bad-status", "Say whether the post is Posted or Pending.");
+  const type = typeof data["type"] === "string" ? data["type"].trim() : "";
+
+  const caller = request.auth!.uid;
+  const onBehalf = typeof data["postedBy"] === "string" && data["postedBy"] && data["postedBy"] !== caller ? data["postedBy"] : null;
+  if (onBehalf && !MANAGERS.includes(role)) throw new HttpsError("permission-denied", "You can log only your own posts.");
+
+  return db().runTransaction(async (tx) => {
+    const poster = await personOf(onBehalf ?? caller, tx);
+    if (!poster || !poster.active || !poster.role || !PEOPLE.includes(poster.role)) {
+      throw refuse("failed-precondition", "unknown-person", "That person isn't active on the team.");
+    }
+    const accounts = poster.fbProfiles.map((p) => p.account);
+    if (accounts.length > 0 && !accounts.includes(fbAccount)) {
+      throw refuse("permission-denied", "forbidden", `${onBehalf ? `${poster.name} is` : "You are"} not assigned to ${fbAccount}.`);
+    }
+
+    // One reading of the clock for the check and the post, so the two can't fall either side of midnight.
+    const now = new Date();
+    const today = manilaDay(now);
+    const rules = await rulesNow(tx);
+    const cooldown = await tx.get(cooldowns().doc(folderId));
+    const last = cooldown.get("last") as string | undefined;
+    const refused = last ? cooldownWords(last, today, rules.cooldownDays) : null;
+    if (refused) throw refuse("failed-precondition", "cooldown", refused.message, { lastPosted: last, nextAllowed: refused.nextAllowed });
+
+    const item = await openItem(tx, poster.uid, folderId);
+    const post = posts().doc();
+    const time = manilaTime(now);
+    tx.set(post, {
+      folderId,
+      title,
+      type,
+      fbAccount,
+      link,
+      status,
+      by: poster.uid,
+      byName: poster.name,
+      ...(onBehalf ? { loggedBy: caller } : {}),
+      date: today,
+      time,
+      at: FieldValue.serverTimestamp(),
+      sheetCopied: false,
+    });
+    tx.set(cooldowns().doc(folderId), { last: today, post: post.id });
+    if (item) tx.update(item, { status });
+    return { id: post.id, status, date: today, time, type, by: poster.uid, byName: poster.name };
+  });
+});
+
+/** A Pending post made Posted, with its live link. An agent completes only their own. */
+export const addLink = onCall(async (request) => {
+  const role = await requireCurrentRole(request, PEOPLE);
+  const data = fields(request);
+  const id = textIn(data, "postId", "Pick a post.");
+  const link = typeof data["link"] === "string" ? data["link"].trim() : "";
+  if (!link) throw refuse("invalid-argument", "link-required", "Paste the post's link.");
+  if (!isPostLink(link)) throw refuse("invalid-argument", "bad-link", "That isn't a Facebook link.");
+
+  return db().runTransaction(async (tx) => {
+    const post = await tx.get(posts().doc(id));
+    if (!post.exists || post.get("status") !== "Pending") throw refuse("not-found", "notfound", "No pending post for that listing.");
+    const by = String(post.get("by"));
+    if (role === "agent" && by !== request.auth!.uid) throw refuse("not-found", "notfound", "No pending post for that listing.");
+    const item = await openItem(tx, by, String(post.get("folderId")));
+    tx.update(post.ref, { status: "Posted", link, sheetCopied: false });
+    if (item) tx.update(item, { status: "Posted" });
+    return { id };
+  });
+});
+
+/**
+ * One queue item moved to Not Shared, Pending or Posted. An agent moves only their own. Posted also makes the
+ * assignee's newest Pending post of the listing Posted: approved in the group, so the post is live too.
+ */
+export const setStatus = onCall(async (request) => {
+  const role = await requireCurrentRole(request, PEOPLE);
+  const data = fields(request);
+  const id = textIn(data, "assignmentId", "Pick a queue item.");
+  const status = data["status"];
+  if (!(QUEUE_STATUSES as readonly unknown[]).includes(status)) throw refuse("invalid-argument", "bad-status", "Pick Not Shared, Pending or Posted.");
+
+  return db().runTransaction(async (tx) => {
+    const item = await tx.get(assignments().doc(id));
+    const assignedTo = String(item.get("assignedTo") ?? "");
+    const notFound = refuse("not-found", "notfound", "That queue item isn't there any more. Reload the queue.");
+    if (!item.exists || (role === "agent" && assignedTo !== request.auth!.uid)) throw notFound;
+    if (item.get("status") === "Posted") throw refuse("failed-precondition", "posted", "That item is posted already.");
+    let pending: FirebaseFirestore.QueryDocumentSnapshot | undefined;
+    if (status === "Posted") {
+      const mine = await tx.get(posts().where("by", "==", assignedTo).where("folderId", "==", String(item.get("folderId"))));
+      pending = mine.docs.filter((p) => p.get("status") === "Pending").sort((a, b) => String(b.get("date")).localeCompare(String(a.get("date"))))[0];
+    }
+    tx.update(item.ref, { status });
+    if (pending) tx.update(pending.ref, { status: "Posted", sheetCopied: false });
+    return { id };
+  });
+});
+
+// ---- Weekly queues ---------------------------------------------------------------------------------
+
+interface QueueIn {
+  person: Person;
+  items: { folderId: string; name: string; status: QueueStatus }[];
+}
+
+/** A listing someone else holds, as the refusal lists it. */
+interface Held {
+  folderId: string;
+  name: string;
+  heldBy: string;
+  heldByName: string;
+  week: string;
+}
+
+/**
+ * Several agents' queues for one week, all or none: each named agent's items of that week are replaced, and nobody
+ * else's are touched. Refused when a listing is held: an open (Not Shared) item of a week that isn't over holds its
+ * listing for its agent until it's posted, or the week ends. Re-saving the same agent's week releases their own items.
+ */
+export const saveQueues = onCall(async (request) => {
+  await requireCurrentRole(request, MANAGERS);
+  const data = fields(request);
+  const week = data["week"];
+  if (!isMonday(week)) throw refuse("invalid-argument", "bad-week", "The week must be a Monday written yyyy-MM-dd.");
+  if (!Array.isArray(data["queues"])) throw refuse("invalid-argument", "bad-queues", "Send the queues as a list.");
+
+  return db().runTransaction(async (tx) => {
+    const queues: QueueIn[] = [];
+    for (const raw of data["queues"] as unknown[]) {
+      const q = typeof raw === "object" && raw !== null ? (raw as Record<string, unknown>) : {};
+      const uid = typeof q["assignedTo"] === "string" ? q["assignedTo"] : "";
+      const person = uid ? await personOf(uid, tx) : null;
+      if (!person || !person.active || person.role !== "agent") throw refuse("invalid-argument", "bad-agent", `${person?.name || "That person"} isn't an active agent.`);
+      if (queues.some((other) => other.person.uid === uid)) {
+        throw refuse("invalid-argument", "bad-queues", `${person.name} has two queues for the week of ${weekLabel(week)}. Send one.`);
+      }
+      if (!Array.isArray(q["items"])) throw refuse("invalid-argument", "bad-queues", `${person.name}'s items must be a list.`);
+      const items = (q["items"] as unknown[]).map((rawItem, i) => {
+        const it = typeof rawItem === "object" && rawItem !== null ? (rawItem as Record<string, unknown>) : {};
+        const folderId = typeof it["folderId"] === "string" ? it["folderId"].trim() : "";
+        const name = typeof it["name"] === "string" ? it["name"].trim() : "";
+        if (!folderId || !name) throw refuse("invalid-argument", "bad-queues", `Item ${i + 1} of ${person.name}'s queue has no listing.`);
+        const status = (QUEUE_STATUSES as readonly unknown[]).includes(it["status"]) ? (it["status"] as QueueStatus) : NOT_SHARED;
+        return { folderId, name, status };
+      });
+      queues.push({ person, items });
+    }
+
+    // Every read before any write, as a transaction requires.
+    const today = manilaDay(new Date());
+    const named = new Set(queues.map((q) => q.person.uid));
+    const openNow = await tx.get(assignments().where("status", "==", NOT_SHARED).where("week", ">=", weekOf(today)));
+    const replaced = await tx.get(assignments().where("week", "==", week));
+
+    const holders: Held[] = openNow.docs
+      .filter((d) => !isWeekOver(String(d.get("week")), today))
+      .filter((d) => !(d.get("week") === week && named.has(String(d.get("assignedTo")))))
+      .map((d) => ({
+        folderId: String(d.get("folderId")),
+        name: String(d.get("name")),
+        heldBy: String(d.get("assignedTo")),
+        heldByName: String(d.get("assignedToName")),
+        week: String(d.get("week")),
+      }));
+    const held: Held[] = [];
+    for (const q of queues) {
+      for (const it of q.items) {
+        const holder = holders.find((h) => h.folderId === it.folderId && h.heldBy !== q.person.uid) ?? holders.find((h) => h.folderId === it.folderId && h.week !== week);
+        if (holder) held.push({ ...holder, name: it.name });
+        else holders.push({ folderId: it.folderId, name: it.name, heldBy: q.person.uid, heldByName: q.person.name, week });
+      }
+    }
+    if (held.length > 0) {
+      const first = held[0]!;
+      const more = held.length > 1 ? ` ${held.length - 1} more ${held.length === 2 ? "is" : "are"} held too.` : "";
+      throw refuse(
+        "failed-precondition",
+        "held",
+        `${first.name} is already with ${first.heldByName} (queue for the week of ${weekLabel(first.week)}). Remove it from their queue first.${more}`,
+        { held },
+      );
+    }
+
+    for (const doc of replaced.docs) if (named.has(String(doc.get("assignedTo")))) tx.delete(doc.ref);
+    let saved = 0;
+    for (const q of queues) {
+      q.items.forEach((it, order) => {
+        tx.set(assignments().doc(), { week, assignedTo: q.person.uid, assignedToName: q.person.name, folderId: it.folderId, name: it.name, order, status: it.status, by: request.auth!.uid, at: FieldValue.serverTimestamp() });
+        saved++;
+      });
+    }
+    audit(tx, request, "save queues", { week, queues: queues.map((q) => ({ assignedTo: q.person.uid, items: q.items.length })) });
+    return { saved };
+  });
+});
+
+// ---- Rules and FB accounts -------------------------------------------------------------------------
+
+/** The posting rules: only the ones sent change, each a whole number within its limits, or nothing is saved. */
+export const setRules = onCall(async (request) => {
+  await requireCurrentRole(request, MANAGERS);
+  const data = fields(request);
+  const changes: Partial<Rules> = {};
+  for (const name of Object.keys(RULE_LIMITS) as RuleName[]) {
+    const value = data[name];
+    if (value === undefined || value === null || value === "") continue;
+    const spec = RULE_LIMITS[name];
+    if (typeof value !== "number" || !Number.isInteger(value) || value < spec.min || value > spec.max) {
+      throw refuse("invalid-argument", "bad-rules", `${spec.label} must be a whole number from ${spec.min} to ${spec.max}.`, { field: name });
+    }
+    changes[name] = value;
+  }
+  return db().runTransaction(async (tx) => {
+    const before = await rulesNow(tx);
+    tx.set(rulesDoc(), changes, { merge: true });
+    audit(tx, request, "set rules", changes, before);
+    return { rules: { ...before, ...changes } };
+  });
+});
+
+/** The FB accounts as sent: each name once, no commas, each link Facebook's. Rows with neither are dropped. */
+function profilesIn(value: unknown): FbProfile[] {
+  if (!Array.isArray(value)) throw refuse("invalid-argument", "bad-accounts", "The Facebook accounts must be a list.");
+  const out: FbProfile[] = [];
+  for (const raw of value as unknown[]) {
+    const p = typeof raw === "object" && raw !== null ? (raw as Record<string, unknown>) : null;
+    if (!p || typeof p["account"] !== "string" || (p["link"] !== undefined && typeof p["link"] !== "string")) {
+      throw refuse("invalid-argument", "bad-accounts", "The Facebook accounts must be a list.");
+    }
+    const account = p["account"].trim();
+    const link = profileLink(typeof p["link"] === "string" ? p["link"] : "");
+    if (link === null) throw refuse("invalid-argument", "bad-profile-link", "That isn't a Facebook profile link.");
+    if (!account && !link) continue;
+    if (!account) throw refuse("invalid-argument", "bad-accounts", `Type the name of the account for ${link}.`);
+    if (account.includes(",")) throw refuse("invalid-argument", "bad-accounts", "A Facebook account name cannot contain a comma.");
+    if (out.some((o) => o.account.toLowerCase() === account.toLowerCase())) throw refuse("invalid-argument", "bad-accounts", `${account} is listed twice.`);
+    out.push({ account, link });
+  }
+  return out;
+}
+
+/**
+ * A person's FB accounts, each with its own profile link (one person may run several). Who may change whose follows
+ * the People screen's rule: an owner anyone's, an admin an agent's. Anyone may change their own.
+ */
+export const setFbProfiles = onCall(async (request) => {
+  const caller = await requireCurrentRole(request, MANAGERS);
+  const data = fields(request);
+  const uid = textIn(data, "uid", "Pick a person.");
+  const fbProfiles = profilesIn(data["fbProfiles"]);
+  return db().runTransaction(async (tx) => {
+    const person = await personOf(uid, tx);
+    if (!person) throw refuse("not-found", "notfound", "That person isn't on the team.");
+    if (uid !== request.auth!.uid && !mayManage(caller, person.role)) {
+      throw new HttpsError("permission-denied", caller === "admin" ? "Admins can change agents only." : "Your account can't do this.");
+    }
+    tx.set(db().collection("users").doc(uid), { fbProfiles }, { merge: true });
+    audit(tx, request, "set FB accounts", { user: uid, fbProfiles }, { fbProfiles: person.fbProfiles });
+    return { fbProfiles };
+  });
+});
+
